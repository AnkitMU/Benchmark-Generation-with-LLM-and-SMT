-- Benchmark: CarRental / balanced
-- Type: UNSAT Constraints Only
-- Generated: 2026-10-15T11:48:10.126154
-- Count: 16

-- #1 Numeric Attribute Positive (UNSAT) in Payment
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Payment
inv: ((self.amount > 0) and (self.amount <> self.discount)) and (self.amount < -5)

-- #2 XOR Condition (UNSAT) in Branch
-- Difficulty: difficult
-- Mutation Strategy: contradictory_bounds
context Branch
inv: ((self.vehicleCount <= 50) and (self.rentals->forAll(v | v.totalAmount > 2))) and (self.vehicleCount > 50)

-- #3 Navigation Chain (UNSAT) in Branch
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Branch
inv: (self.company.isActive <> false) and (not(self.company.isActive <> false))

-- #4 Collection Size Constraint (UNSAT) in Customer
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Customer
inv: (self.rentals->size() <= 1) and (self.rentals->size() > 1)

-- #5 Numeric Greater Than Value (UNSAT) in Customer
-- Difficulty: easy
-- Mutation Strategy: contradictory_bounds
context Customer
inv: (self.rentalCount > 2) and (self.rentalCount < -3)

-- #6 Association Exists (UNSAT) in Rental
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Rental
inv: (self.payment <> null) and (not(self.payment <> null))

-- #7 Navigation Consistency (UNSAT) in Reservation
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Reservation
inv: ((self.vehicle.branch = self.branch) and (self.isConfirmed = true)) and (not((self.vehicle.branch = self.branch) and (self.isConfirmed = true)))

-- #8 Bi-directional Implication (UNSAT) in Branch
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Branch
inv: ((self.capacity <> null) = (self.vehicleCount <> null)) and (not((self.capacity <> null) = (self.vehicleCount <> null)))

-- #9 Collection Not Empty (Simple) (UNSAT) in Branch
-- Difficulty: unboxed
-- Mutation Strategy: empty_collection
context Branch
inv: (self.reservations->notEmpty()) and (self.reservations->isEmpty())

-- #10 All Attributes Defined (UNSAT) in Payment
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Payment
inv: (self.tax <> null and self.amount <> null) and (not(self.tax <> null and self.amount <> null))

-- #11 Three Way Comparison (UNSAT) in Payment
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Payment
inv: (self.discount <= self.tax and self.tax <= self.amount) and (not(self.discount <= self.tax and self.tax <= self.amount))

-- #12 Collection Navigation (UNSAT) in Branch
-- Difficulty: unboxed
-- Mutation Strategy: universal_negation
context Branch
inv: ((self.reservations->forAll(x | x.estimatedCost > 0)) and (self.address.indexOf('test') >= 0)) and (self.reservations->exists(x | not(x.estimatedCost > 0)))

-- #13 Collection Size in Range (UNSAT) in Customer
-- Difficulty: unboxed
-- Mutation Strategy: contradictory_bounds
context Customer
inv: (self.reservations->size() >= 3 and self.reservations->size() <= 3) and (self.reservations->size() < 3)

-- #14 Collection Sum (UNSAT) in Branch
-- Difficulty: unboxed
-- Mutation Strategy: contradictory_bounds
context Branch
inv: (((self.reservations->collect(x | x.estimatedCost)->sum() >= 5) and (self.company.isActive)) and (self.vehicles->size() = 2)) and (self.vehicles->size() <> 2)

-- #15 Flatten Operation (UNSAT) in Company
-- Difficulty: unboxed
-- Mutation Strategy: contradictory_bounds
context Company
inv: ((self.branches->collect(x | x.rentals)->flatten()->notEmpty()) and (self.branches->size() >= 1)) and (self.branches->size() < 1)

-- #16 Collection Index Of Element (UNSAT) in Branch
-- Difficulty: difficult
-- Mutation Strategy: contradictory_bounds
context Branch
inv: ((self.monthlyRevenue >= 0) and (self.rentals->forAll(v | v.mileageStart < 50))) and (self.monthlyRevenue < 0)

