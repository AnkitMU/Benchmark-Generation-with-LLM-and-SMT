-- Difficulty: medium
context Customer
inv: (self.kyc.isVerified) and (self.email.size() <= 43)

-- #27 Numeric Attribute Bounded in Account
-- Difficulty: difficult
context Account
inv: (self.balance < 100) and (self.transactions->forAll(v | v.amount > 2))

-- #28 Any Operation in Account
-- Difficulty: difficult
context Account
inv: self.transactions->any(x | x.amount >= 10) <> null

-- #29 Select (Filter) Operation in Account
-- Difficulty: difficult
context Account
inv: self.transactions->select(x | x.amount >= 10)->size() >= 1

-- #30 Numeric Attribute Positive in SavingsAccount
-- Difficulty: easy
context SavingsAccount
inv: self.interestRate > 0

-- #31 Numeric Less Than Value in CheckingAccount
-- Difficulty: easy
context CheckingAccount
