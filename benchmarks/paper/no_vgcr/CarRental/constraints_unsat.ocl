context License
inv: ((self.customer <> null) and (self.number.toLowerCase() = 'test')) and (not((self.customer <> null) and (self.number.toLowerCase() = 'test')))

-- #11 All Attributes Defined (UNSAT) in Reservation
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Reservation
inv: (self.createdAt <> null and self.confirmedAt <> null) and (not(self.createdAt <> null and self.confirmedAt <> null))

-- #12 Collection Minimum Size (UNSAT) in Vehicle
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Vehicle
inv: (self.rentals->size() >= 3) and (self.rentals->size() < 3)

-- #13 Association Exists (UNSAT) in License
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context License
inv: ((self.customer <> null) and (self.expiry.size() >= 4)) and (not((self.customer <> null) and (self.expiry.size() >= 4)))

-- #14 Three Way Comparison (UNSAT) in Branch
-- Difficulty: difficult
-- Mutation Strategy: contradictory_bounds
context Branch
inv: ((self.monthlyRevenue < 1000) and (self.vehicles->forAll(v | v.seats <= 50))) and (self.monthlyRevenue > 1005)

-- #15 Numeric Sum Constraint (UNSAT) in Branch
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Branch
inv: (self.capacity + self.vehicleCount > 53) and (not(self.capacity + self.vehicleCount > 53))

-- #16 Collection Nested Collection Flatten (UNSAT) in Company
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Company
inv: (self.branches->collect(x | x.reservations)->size() >= 3) and (not(self.branches->collect(x | x.reservations)->size() >= 3))

-- #17 Numeric Absolute Value Bounded (UNSAT) in Customer
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Customer
inv: (self.balance.abs() <= 8) and (not(self.balance.abs() <= 8))

-- #18 Two Attributes Not Equal (UNSAT) in Rental
