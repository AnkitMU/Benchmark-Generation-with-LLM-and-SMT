-- #27 Numeric Attribute Bounded in Fine
-- Difficulty: difficult
context Fine
inv: (self.amount <= 50) and (self.payments->forAll(v | v.amount <= 50))

-- #28 Numeric Multiple Of in Book
-- Difficulty: easy
context Book
inv: self.publishYear mod 6 = 0

