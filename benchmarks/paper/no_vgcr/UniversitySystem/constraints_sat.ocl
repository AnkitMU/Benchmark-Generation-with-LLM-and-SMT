-- Benchmark: UniversitySystem / balanced
-- Type: SAT Constraints Only
-- Generated: 2026-10-12T20:27:11.115813
-- Count: 67

-- #1 Navigation Chain in Faculty
-- Difficulty: easy
context Faculty
inv: self.university.name <> ''

-- #2 Navigation Chain in Faculty
-- Difficulty: easy
context Faculty
inv: self.university.code <> ''

-- #3 Association Exists in Course
-- Difficulty: easy
context Course
inv: self.department <> null

-- #4 Association Exists in GradeRecord
-- Difficulty: medium
context GradeRecord
inv: (self.enrollment <> null) and (self.enrollment.student.yearOfStudy >= 0)

-- #5 Association Exists in Exam
-- Difficulty: medium
context Exam
inv: (self.offering <> null) and (self.offering.oclIsTypeOf(CourseOffering))

-- #6 Association Exists in CourseOffering
-- Difficulty: easy
context CourseOffering
inv: self.semester <> null

-- #7 Association Exists in Room
-- Difficulty: medium
context Room
inv: (self.building <> null) and (self.offerings->size() = 3)

-- #8 Association Exists in Department
-- Difficulty: easy
context Department
inv: self.faculty <> null

-- #9 Association Exists in Enrollment
-- Difficulty: medium
context Enrollment
inv: (self.offering <> null) and (self.enrolledAt.size() >= 5)

-- #10 Association Exists in Building
-- Difficulty: medium
context Building
inv: (self.university <> null) and (self.university.code <> '')

-- #11 Association Exists in Enrollment
-- Difficulty: medium
context Enrollment
inv: (self.grade <> null) and (self.student.oclIsTypeOf(Student))

-- #12 Navigation Chain in CourseOffering
-- Difficulty: medium
context CourseOffering
inv: self.course.department.name <> ''

