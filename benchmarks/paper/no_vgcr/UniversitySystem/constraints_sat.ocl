inv: self.attempts->collect(x | x.marks)->sum() >= 2

-- #61 Flatten Operation in Department
-- Difficulty: difficult
context Department
inv: self.instructors->collect(x | x.offerings)->flatten()->notEmpty()

-- #62 Association Exists in Building
-- Difficulty: easy
context Building
inv: self.university <> null

-- #63 Association Exists in CourseOffering
-- Difficulty: easy
context CourseOffering
inv: self.course <> null

-- #64 Association Exists in CourseOffering
-- Difficulty: easy
