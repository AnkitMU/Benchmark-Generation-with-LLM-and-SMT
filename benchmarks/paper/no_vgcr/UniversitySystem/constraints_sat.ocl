-- Difficulty: easy
context CourseOffering
inv: self.enrollments->notEmpty()

-- #44 Collection Has Specific Size in Department
-- Difficulty: easy
context Department
inv: self.staff->size() = 1

-- #45 Collection Not Empty Check in Building
-- Difficulty: easy
context Building
inv: self.rooms->size() > 0

-- #46 Collection Must Be Empty in Department
-- Difficulty: easy
context Department
inv: self.instructors->isEmpty()

-- #47 Collection Size Constraint in CourseOffering
-- Difficulty: easy
context CourseOffering
inv: self.exams->size() >= 1

-- #48 Collection Not Empty (Simple) in Department
-- Difficulty: easy
context Department
inv: self.courses->notEmpty()

-- #49 Collection Has Specific Size in CourseOffering
-- Difficulty: easy
context CourseOffering
inv: self.exams->size() = 1

-- #50 Collection Maximum Size in Exam
-- Difficulty: medium
context Exam
inv: self.attempts->size() <= 1

-- #51 Simple Implication in Scholarship
-- Difficulty: medium
context Scholarship
inv: self.startYear <> null implies self.endYear <> null

-- #52 Reverse Implication in Semester
-- Difficulty: medium
context Semester
inv: self.startDate <> null implies self.endDate <> null

-- #53 Collection Minimum Size in CourseOffering
-- Difficulty: medium
context CourseOffering
inv: self.enrollments->size() >= 1

-- #54 Collection Maximum Size in Course
-- Difficulty: medium
context Course
inv: self.offerings->size() <= 1

-- #55 Collection Maximum Size in Building
-- Difficulty: medium
context Building
inv: self.rooms->size() <= 3

-- #56 Bi-directional Implication in Semester
-- Difficulty: medium
context Semester
inv: (self.endDate <> null) = (self.startDate <> null)

-- #57 Flatten Operation in CourseOffering
-- Difficulty: difficult
context CourseOffering
inv: self.exams->collect(x | x.attempts)->flatten()->notEmpty()

-- #58 Collection Sum in Course
-- Difficulty: difficult
context Course
inv: self.offerings->collect(x | x.capacity)->sum() >= 7

-- #59 Flatten Operation in Faculty
-- Difficulty: difficult
context Faculty
inv: self.departments->collect(x | x.instructors)->flatten()->notEmpty()

