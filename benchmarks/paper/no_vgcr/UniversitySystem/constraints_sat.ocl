-- #14 Navigation Chain in CourseOffering
-- Difficulty: medium
context CourseOffering
inv: self.course.department.code <> ''

-- #15 Navigation Chain in Department
-- Difficulty: medium
context Department
inv: self.faculty.university.name <> ''

-- #16 Simple Navigation in Student
-- Difficulty: medium
context Student
inv: ((self.libraryAccount.isBlocked) and (self.yearOfStudy > 0)) and (self.examAttempts->size() = 1)

-- #17 Navigation Chain in Department
-- Difficulty: medium
context Department
inv: self.faculty.university.code <> ''

-- #18 Navigation Chain in Enrollment
-- Difficulty: medium
context Enrollment
inv: self.student.program.durationYears >= 0

-- #19 Collection Navigation in Semester
-- Difficulty: difficult
context Semester
inv: self.offerings->exists(x | x.capacity >= 1)

-- #20 Collection Navigation in University
-- Difficulty: difficult
context University
inv: self.buildings->exists(x | x.name <> '')

-- #21 Collection Navigation in Department
-- Difficulty: difficult
context Department
inv: self.programs->forAll(x | x.durationYears >= 0)

-- #22 Collection Navigation in CourseOffering
-- Difficulty: difficult
context CourseOffering
inv: self.enrollments->forAll(x | x.enrolledAt <> '')

-- #23 Collection Navigation in Exam
-- Difficulty: difficult
context Exam
inv: (self.attempts->forAll(x | x.marks > 5)) and (self.maxMarks >= 0)

-- #24 Numeric Absolute Value Bounded in CourseOffering
-- Difficulty: difficult
context CourseOffering
inv: (self.capacity <= 100) and (self.exams->forAll(v | v.maxMarks <= 10))

-- #25 Select (Filter) Operation in Department
-- Difficulty: difficult
context Department
inv: self.programs->select(x | x.durationYears <= 50)->size() >= 1

-- #26 Any Operation in CourseOffering
-- Difficulty: difficult
context CourseOffering
inv: self.enrollments->any(x | x.enrolledAt <> '') <> null

-- #27 Select (Filter) Operation in CourseOffering
-- Difficulty: difficult
context CourseOffering
inv: self.exams->select(x | x.maxMarks >= 0)->size() >= 1

-- #28 Select (Filter) Operation in Exam
-- Difficulty: difficult
context Exam
inv: self.attempts->select(x | x.marks >= 10)->size() >= 1

-- #29 Numeric Is Odd in CourseOffering
-- Difficulty: easy
context CourseOffering
inv: self.capacity mod 2 = 1

-- #30 Numeric Sum Constraint in Scholarship
-- Difficulty: easy
context Scholarship
inv: self.startYear + self.endYear > 29

-- #31 Numeric Sum Constraint in Scholarship
-- Difficulty: easy
context Scholarship
inv: self.startYear + self.endYear > 53

-- #32 Numeric Difference Constraint in Scholarship
-- Difficulty: easy
context Scholarship
inv: self.startYear - self.endYear >= 0

-- #33 Numeric Sum Constraint in Scholarship
-- Difficulty: easy
context Scholarship
inv: self.endYear + self.startYear > 26

-- #34 Numeric Attribute Positive in Course
-- Difficulty: easy
context Course
inv: self.credits > 0

-- #35 Numeric Absolute Value Bounded in Course
-- Difficulty: medium
context Course
inv: self.credits.abs() <= 10

-- #36 Numeric Absolute Value Bounded in CourseOffering
-- Difficulty: medium
context CourseOffering
inv: self.capacity.abs() <= 0

-- #37 Numeric Attribute Bounded in Course
-- Difficulty: medium
context Course
inv: self.credits >= 40 and self.credits <= 49

-- #38 Numeric Attribute Non-Negative in CourseOffering
-- Difficulty: medium
context CourseOffering
inv: (self.capacity >= 0) and (self.section.size() <= 77)

-- #39 Numeric Attribute Bounded in CourseOffering
-- Difficulty: medium
context CourseOffering
inv: self.capacity >= 67 and self.capacity <= 96

-- #40 Collection Size Constraint in Building
-- Difficulty: easy
context Building
inv: self.rooms->size() <= 1

-- #41 Collection Has Specific Size in Department
-- Difficulty: easy
context Department
inv: self.programs->size() = 3

-- #42 Collection Not Empty Check in Course
-- Difficulty: easy
context Course
