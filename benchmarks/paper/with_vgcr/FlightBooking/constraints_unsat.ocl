context Baggage
inv: (self.weightKg < 32) and (self.weightKg > 37)

-- #10 Existential Quantification (exists) (UNSAT) in Airline
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Airline
inv: (self.aircrafts->exists(x | x.model <> '')) and (not(self.aircrafts->exists(x | x.model <> '')))

