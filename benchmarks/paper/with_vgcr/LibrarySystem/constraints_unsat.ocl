context Branch
inv: (self.address <> null) and (not(self.address <> null))

-- #10 Association Exists (UNSAT) in Copy
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Copy
inv: ((self.book <> null) and (self.loans->isEmpty())) and (not((self.book <> null) and (self.loans->isEmpty())))

-- #11 Collection Not Empty Check (UNSAT) in Branch
-- Difficulty: medium
-- Mutation Strategy: empty_collection
context Branch
inv: (self.reservations->size() > 0) and (self.reservations->size() <= 0)

-- #12 Simple Implication (UNSAT) in Loan
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Loan
inv: (self.dueDate <> null implies self.returnDate <> null) and (not(self.dueDate <> null implies self.returnDate <> null))

-- #13 Numeric Is Odd (UNSAT) in Book
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Book
