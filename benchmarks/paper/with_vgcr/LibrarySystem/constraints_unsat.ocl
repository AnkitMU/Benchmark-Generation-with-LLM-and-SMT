-- #1 Navigation Chain (UNSAT) in Address
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Address
inv: (self.branch.library.maxLoanDays >= 2) and (not(self.branch.library.maxLoanDays >= 2))

-- #2 Navigation Chain (UNSAT) in Branch
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Branch
inv: (self.address.branch.name <> '') and (not(self.address.branch.name <> ''))

-- #3 Collection Navigation (UNSAT) in Book
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Book
inv: (self.copies->exists(x | x.barcode <> '')) and (not(self.copies->exists(x | x.barcode <> '')))

-- #4 Collection Nested Collection Flatten (UNSAT) in Book
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Book
inv: (self.copies->collect(x | x.loans)->size() >= 3) and (not(self.copies->collect(x | x.loans)->size() >= 3))

-- #5 Numeric Attribute Bounded (UNSAT) in Book
-- Difficulty: unboxed
-- Mutation Strategy: contradictory_bounds
context Book
inv: (self.publishYear >= 2 and self.publishYear <= 15) and (self.publishYear < 2)

-- #6 Association Exists (UNSAT) in Copy
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Copy
inv: ((self.book <> null) and (self.barcode.toUpperCase() = 'TEST')) and (not((self.book <> null) and (self.barcode.toUpperCase() = 'TEST')))

-- #7 Collection Has Specific Size (UNSAT) in Category
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Category
inv: (self.books->size() = 1) and (not(self.books->size() = 1))

-- #8 Numeric Multiple Of (UNSAT) in Book
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Book
inv: (self.publishYear mod 6 = 0) and (not(self.publishYear mod 6 = 0))

