-- #14 Collection Navigation (UNSAT) in Publisher
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Publisher
inv: ((self.books->exists(x | x.pages < 100)) and (self.books->size() >= 1)) and (not((self.books->exists(x | x.pages < 100)) and (self.books->size() >= 1)))

-- #15 Collection Not Empty (Simple) (UNSAT) in Book
