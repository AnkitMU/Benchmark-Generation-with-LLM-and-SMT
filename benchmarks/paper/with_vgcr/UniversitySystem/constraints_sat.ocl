-- Benchmark: UniversitySystem / balanced
-- Type: SAT Constraints Only
-- Generated: 2026-10-12T20:22:18.944407
-- Count: 73

-- #1 Navigation Chain in Faculty
-- Difficulty: easy
context Faculty
inv: self.university.name <> ''

-- #2 Simple Navigation in Student
-- Difficulty: easy
context Student
inv: self.libraryAccount.isBlocked

-- #3 Navigation Chain in Faculty
-- Difficulty: easy
context Faculty
inv: self.university.code <> ''

-- #4 Association Exists in Course
-- Difficulty: easy
context Course
inv: self.department <> null

-- #5 Association Exists in GradeRecord
-- Difficulty: medium
context GradeRecord
inv: (self.enrollment <> null) and (self.enrollment.student.yearOfStudy >= 0)

-- #6 Association Exists in ExamAttempt
-- Difficulty: medium
context ExamAttempt
inv: (self.student <> null) and (self.marks > 75)

-- #7 Association Exists in Program
-- Difficulty: medium
context Program
inv: (self.department <> null) and (self.students->notEmpty())

-- #8 Association Exists in CourseOffering
-- Difficulty: easy
context CourseOffering
inv: self.semester <> null

-- #9 Association Exists in Instructor
-- Difficulty: medium
context Instructor
inv: (self.department <> null) and (self.name.toUpperCase() = 'TEST')

-- #10 Association Exists in Scholarship
-- Difficulty: easy
context Scholarship
inv: self.student <> null

-- #11 Association Exists in LibraryAccount
-- Difficulty: medium
context LibraryAccount
inv: (self.student <> null) and (self.isBlocked = false)

-- #12 Association Exists in Building
-- Difficulty: medium
context Building
inv: (self.university <> null) and (self.university.code <> '')

-- #13 Navigation Chain in CourseOffering
-- Difficulty: medium
context CourseOffering
inv: self.course.department.name <> ''

-- #14 Navigation Chain in Staff
-- Difficulty: medium
context Staff
inv: self.department.faculty.name <> ''

-- #15 Navigation Chain in CourseOffering
-- Difficulty: medium
context CourseOffering
inv: self.course.department.code <> ''

-- #16 Navigation Chain in Department
-- Difficulty: medium
context Department
inv: self.faculty.university.code <> ''

-- #17 Navigation Chain in Enrollment
-- Difficulty: medium
context Enrollment
inv: self.student.program.durationYears >= 0

-- #18 Collection Navigation in Semester
-- Difficulty: difficult
context Semester
inv: self.offerings->exists(x | x.capacity >= 1)

-- #19 Collection Navigation in University
-- Difficulty: difficult
context University
inv: self.buildings->exists(x | x.name <> '')

-- #20 Collection Navigation in Department
-- Difficulty: difficult
context Department
inv: self.programs->forAll(x | x.durationYears >= 0)

-- #21 Collection Navigation in CourseOffering
-- Difficulty: difficult
context CourseOffering
inv: self.enrollments->forAll(x | x.enrolledAt <> '')

-- #22 Collection Navigation in Exam
-- Difficulty: difficult
context Exam
inv: (self.attempts->forAll(x | x.marks > 5)) and (self.maxMarks >= 0)

-- #23 Numeric Attribute Bounded in Course
-- Difficulty: difficult
context Course
inv: (self.credits > 10) and (self.offerings->forAll(v | v.capacity > 0))

-- #24 Numeric Attribute Non-Negative in Exam
-- Difficulty: difficult
context Exam
inv: (self.maxMarks > 0) and (self.attempts->forAll(v | v.marks <= 10))

-- #25 Numeric Greater Than Value in Course
-- Difficulty: difficult
context Course
inv: (self.credits >= 2) and (self.offerings->forAll(v | v.capacity <= 10))

-- #26 Numeric Absolute Value Bounded in Room
-- Difficulty: difficult
context Room
inv: (self.capacity <= 100) and (self.offerings->forAll(v | v.capacity >= 10))

-- #27 Numeric Is Odd in CourseOffering
-- Difficulty: difficult
context CourseOffering
inv: (self.capacity >= 5) and (self.exams->forAll(v | v.maxMarks <= 1000))

-- #28 Numeric Absolute Value Bounded in CourseOffering
-- Difficulty: difficult
context CourseOffering
inv: (self.capacity <= 100) and (self.exams->forAll(v | v.maxMarks <= 10))

-- #29 Select (Filter) Operation in Department
-- Difficulty: difficult
context Department
inv: self.programs->select(x | x.durationYears <= 50)->size() >= 1

-- #30 Any Operation in Building
-- Difficulty: difficult
context Building
inv: self.rooms->any(x | x.capacity >= 10) <> null

-- #31 Numeric Is Even in Course
-- Difficulty: easy
context Course
inv: self.credits mod 2 = 0

-- #32 Numeric Comparison in Scholarship
-- Difficulty: easy
context Scholarship
inv: self.endYear >= self.startYear

-- #33 Numeric Is Odd in CourseOffering
-- Difficulty: easy
context CourseOffering
inv: self.capacity mod 2 = 1

-- #34 Numeric Comparison in Scholarship
-- Difficulty: easy
context Scholarship
inv: self.endYear <= self.startYear

-- #35 Numeric Sum Constraint in Scholarship
-- Difficulty: easy
context Scholarship
inv: self.startYear + self.endYear > 29

-- #36 Numeric Difference Constraint in Scholarship
-- Difficulty: easy
context Scholarship
inv: self.startYear - self.endYear >= 0

-- #37 Numeric Sum Constraint in Scholarship
-- Difficulty: easy
context Scholarship
inv: self.endYear + self.startYear > 26

-- #38 Numeric Attribute Positive in Course
-- Difficulty: easy
context Course
inv: self.credits > 0

-- #39 Numeric Absolute Value Bounded in Course
-- Difficulty: medium
context Course
inv: self.credits.abs() <= 10

-- #40 Numeric Absolute Value Bounded in CourseOffering
-- Difficulty: medium
context CourseOffering
inv: self.capacity.abs() <= 0

-- #41 Numeric Absolute Value Bounded in CourseOffering
-- Difficulty: medium
context CourseOffering
inv: self.capacity.abs() <= 6

-- #42 Numeric Attribute Bounded in Course
-- Difficulty: medium
context Course
inv: self.credits >= 40 and self.credits <= 49

-- #43 Minimum Of Two Attributes in Scholarship
-- Difficulty: medium
context Scholarship
inv: if self.startYear < self.endYear then self.startYear else self.endYear endif >= 19

-- #44 Numeric Absolute Value Bounded in Course
-- Difficulty: medium
context Course
inv: self.credits.abs() <= 3

-- #45 Numeric Absolute Value Bounded in CourseOffering
-- Difficulty: medium
context CourseOffering
inv: self.capacity.abs() <= 3

-- #46 Numeric Attribute Bounded in CourseOffering
-- Difficulty: medium
context CourseOffering
inv: self.capacity >= 67 and self.capacity <= 96

-- #47 Collection Not Empty Check in Course
-- Difficulty: easy
context Course
inv: self.offerings->size() > 0

-- #48 Collection Size Constraint in Building
-- Difficulty: easy
context Building
inv: self.rooms->size() >= 1

-- #49 Collection Not Empty (Simple) in CourseOffering
-- Difficulty: easy
context CourseOffering
inv: self.enrollments->notEmpty()

-- #50 Collection Has Specific Size in Department
-- Difficulty: easy
context Department
inv: self.staff->size() = 1

-- #51 Collection Not Empty Check in Building
-- Difficulty: easy
context Building
inv: self.rooms->size() > 0

-- #52 Collection Must Be Empty in Department
-- Difficulty: easy
context Department
inv: self.instructors->isEmpty()

-- #53 Collection Not Empty (Simple) in Department
-- Difficulty: easy
context Department
inv: self.courses->notEmpty()

-- #54 Collection Has Specific Size in CourseOffering
-- Difficulty: easy
context CourseOffering
inv: self.exams->size() = 1

-- #55 Collection Not Empty Check in Building
-- Difficulty: medium
context Building
inv: (self.rooms->size() > 0) and (self.rooms->notEmpty())

-- #56 Collection Maximum Size in Exam
-- Difficulty: medium
context Exam
inv: self.attempts->size() <= 1

-- #57 Simple Implication in Scholarship
-- Difficulty: medium
context Scholarship
inv: self.startYear <> null implies self.endYear <> null

-- #58 Reverse Implication in Semester
-- Difficulty: medium
context Semester
inv: self.startDate <> null implies self.endDate <> null

-- #59 Collection Maximum Size in Course
-- Difficulty: medium
context Course
inv: self.offerings->size() <= 1

-- #60 Simple Implication in Scholarship
-- Difficulty: medium
context Scholarship
inv: self.endYear <> null implies self.startYear <> null

-- #61 Attribute Not Null (Simple) in Department
-- Difficulty: medium
context Department
inv: (self.code <> null) and (self.code.toUpperCase() = 'TEST')

-- #62 Bi-directional Implication in Semester
-- Difficulty: medium
context Semester
inv: (self.endDate <> null) = (self.startDate <> null)

-- #63 Collection Sum in Course
-- Difficulty: difficult
context Course
inv: self.offerings->collect(x | x.capacity)->sum() >= 7

-- #64 Flatten Operation in Faculty
-- Difficulty: difficult
context Faculty
inv: self.departments->collect(x | x.instructors)->flatten()->notEmpty()

-- #65 Collection Sum in Exam
-- Difficulty: difficult
context Exam
inv: self.attempts->collect(x | x.marks)->sum() >= 2

-- #66 Collection Nested Collection Flatten in Department
-- Difficulty: difficult
context Department
inv: self.courses->collect(x | x.offerings)->size() >= 1

-- #67 Association Exists in Building
-- Difficulty: easy
context Building
inv: self.university <> null

-- #68 Association Exists in CourseOffering
-- Difficulty: easy
context CourseOffering
inv: self.course <> null

-- #69 Association Exists in CourseOffering
-- Difficulty: easy
context CourseOffering
inv: self.room <> null

-- #70 Association Exists in CourseOffering
-- Difficulty: easy
context CourseOffering
inv: self.instructor <> null

-- #71 Numeric Comparison in Scholarship
-- Difficulty: medium
context Scholarship
inv: self.startYear <= self.endYear

-- #72 Attribute Not Null (Simple) in Course
-- Difficulty: difficult
context Course
inv: (self.credits <= 50) and (self.offerings->forAll(v | v.capacity > 0))

-- #73 Collection As Sequence Conversion in Course
-- Difficulty: difficult
context Course
inv: (self.credits <= 10) and (self.offerings->forAll(v | v.capacity < 10))

