-- #2 Numeric Sum Constraint (UNSAT) in Scholarship
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Scholarship
inv: (self.startYear + self.endYear > 53) and (not(self.startYear + self.endYear > 53))

-- #3 Select (Filter) Operation (UNSAT) in Exam
