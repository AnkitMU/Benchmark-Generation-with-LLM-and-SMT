-- #1 Numeric Attribute Bounded (UNSAT) in Baggage
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Baggage
inv: (self.weightKg >= 11 and self.weightKg <= 72) and (self.weightKg < 11)

-- #2 Collection Must Be Empty (UNSAT) in Aircraft
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Aircraft
inv: (((self.seats->isEmpty()) and (self.airline.oclIsTypeOf(Airline))) and (self.registrationNo.indexOf('test') >= 0)) and (not(((self.seats->isEmpty()) and (self.airline.oclIsTypeOf(Airline))) and (self.registrationNo.indexOf('test') >= 0)))

-- #3 Collection Has Specific Size (UNSAT) in Airport
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Airport
inv: (self.departingFlights->size() = 3) and (self.departingFlights->size() <> 3)

-- #4 Flatten Operation (UNSAT) in Airport
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Airport
inv: (self.departingFlights->collect(x | x.bookings)->flatten()->notEmpty()) and (not(self.departingFlights->collect(x | x.bookings)->flatten()->notEmpty()))

-- #5 Numeric Greater Than Value (UNSAT) in Baggage
