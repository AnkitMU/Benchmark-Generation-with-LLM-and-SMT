context Payment
inv: ((self.amount > 0) and (self.method.indexOf('test') >= 0)) and (self.amount < -5)

-- #9 Navigation Chain (UNSAT) in Aircraft
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Aircraft
inv: (self.airline.name <> '') and (not(self.airline.name <> ''))

-- #10 Collection Size in Range (UNSAT) in Aircraft
-- Difficulty: unboxed
-- Mutation Strategy: universal_negation
context Aircraft
