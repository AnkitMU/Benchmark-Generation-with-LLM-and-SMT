-- #5 Navigation Chain (UNSAT) in PowerSource
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context PowerSource
inv: ((self.device.firmware.checksum <> '') and (self.capacity > 0)) and (self.capacity < -5)

