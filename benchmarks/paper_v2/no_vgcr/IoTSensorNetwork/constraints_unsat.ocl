-- Mutation Strategy: self_contradiction
context MaintenanceTicket
inv: (self.otaUpdate.targetDevice = self.device) and (not(self.otaUpdate.targetDevice = self.device))

-- #2 Collection Size Constraint (UNSAT) in DataStream
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context DataStream
inv: (self.alertRules->size() = 1) and (self.alertRules->size() <> 1)

