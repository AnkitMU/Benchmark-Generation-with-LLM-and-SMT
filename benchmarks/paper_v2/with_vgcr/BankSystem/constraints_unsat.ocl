context Account
inv: (self.transactions->size() >= 2) and (self.transactions->size() < 2)

-- #12 Collection Size Constraint (UNSAT) in Account
-- Difficulty: difficult
-- Mutation Strategy: contradictory_bounds
context Account
inv: ((self.transactions->size() = 1) and (self.transactions->collect(x | x.timestamp)->notEmpty())) and (self.transactions->size() <> 1)

-- #13 Numeric Sum Constraint (UNSAT) in Loan
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Loan
inv: (self.principal + self.interestRate > 69) and (not(self.principal + self.interestRate > 69))

-- #14 Flatten Operation (UNSAT) in Customer
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Customer
inv: (self.accounts->collect(x | x.transactions)->flatten()->notEmpty()) and (not(self.accounts->collect(x | x.transactions)->flatten()->notEmpty()))

