-- #1 Collection Size in Range (UNSAT) in CreditCard
-- Difficulty: difficult
-- Mutation Strategy: contradictory_bounds
context CreditCard
inv: ((self.limit <= 10) and (self.cardTransactions->forAll(v | v.merchant <> ''))) and (self.limit > 10)

-- #2 Collection As Sequence Conversion (UNSAT) in Branch
-- Difficulty: unboxed
-- Mutation Strategy: universal_negation
context Branch
inv: ((self.city <> '') and (self.employees->forAll(v | v.name <> ''))) and (self.employees->exists(v | not(v.name <> '')))

-- #3 Navigation Chain (UNSAT) in Account
-- Difficulty: difficult
-- Mutation Strategy: contradictory_bounds
context Account
inv: ((self.balance > 1) and (self.transactions->forAll(v | v.amount > 5))) and (self.balance < -4)

-- #4 Numeric Less Than Value (UNSAT) in Account
-- Difficulty: easy
-- Mutation Strategy: contradictory_bounds
context Account
inv: (self.balance < 69) and (self.balance > 74)

-- #5 Association Exists (UNSAT) in Transaction
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Transaction
inv: (self.payment <> null) and (not(self.payment <> null))

-- #6 Numeric Attribute Bounded (UNSAT) in CreditCard
-- Difficulty: difficult
-- Mutation Strategy: contradictory_bounds
context CreditCard
inv: ((self.limit > 2) and (self.cardTransactions->forAll(v | v.merchant <> ''))) and (self.limit < -3)

-- #7 Any Operation (UNSAT) in Account
-- Difficulty: unboxed
