context Account
inv: ((self.transactions->any(x | x.amount > 2) <> null) and (self.accountNo.size() >= 20)) and (not((self.transactions->any(x | x.amount > 2) <> null) and (self.accountNo.size() >= 20)))

-- #8 Bi-directional Implication (UNSAT) in Address
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Address
inv: ((self.city <> null) = (self.line1 <> null)) and (not((self.city <> null) = (self.line1 <> null)))

-- #9 Collection Not Empty (Simple) (UNSAT) in Bank
-- Difficulty: unboxed
-- Mutation Strategy: contradictory_bounds
context Bank
inv: (((self.branches->notEmpty()) and (self.name <> null)) and (self.branches->size() = 1)) and (self.branches->size() <> 1)

-- #10 Existential Quantification (exists) (UNSAT) in Branch
-- Difficulty: difficult
-- Mutation Strategy: self_contradiction
context Branch
inv: (self.customers->exists(x | x.fullName <> '')) and (not(self.customers->exists(x | x.fullName <> '')))

