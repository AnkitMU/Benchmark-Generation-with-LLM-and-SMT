-- #1 Collection Size in Range (UNSAT) in Department
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Department
inv: ((self.nurses->size() <= 1)) and (self.nurses->size() > 1)

-- #2 Collection Size in Range (UNSAT) in Prescription
-- Difficulty: unboxed
-- Mutation Strategy: universal_negation
context Prescription
inv: ((self.issuedAt <> '') and (self.medications->forAll(v | v.name <> ''))) and (self.medications->exists(v | not(v.name <> '')))

-- #3 Numeric Absolute Value Bounded (UNSAT) in Ward
-- Difficulty: difficult
-- Mutation Strategy: contradictory_bounds
context Ward
inv: ((self.floor > 0) and (self.rooms->forAll(v | v.roomNo <> ''))) and (self.floor < -5)

-- #4 Collection Has Specific Size (UNSAT) in Hospital
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Hospital
inv: (self.wards->size() = 1) and (self.wards->size() <> 1)

-- #5 Boolean Is False (UNSAT) in Bed
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Bed
inv: ((self.isOccupied = false) and (self.bedNo.size() <= 22)) and (not((self.isOccupied = false) and (self.bedNo.size() <= 22)))

-- #6 Collection Not Empty (Simple) (UNSAT) in MedicalRecord
-- Difficulty: unboxed
-- Mutation Strategy: empty_collection
context MedicalRecord
inv: (self.procedures->notEmpty()) and (self.procedures->isEmpty())

-- #7 Existential Quantification (exists) (UNSAT) in Department
-- Difficulty: difficult
-- Mutation Strategy: self_contradiction
context Department
inv: (self.nurses->exists(x | x.nurseId <> '')) and (not(self.nurses->exists(x | x.nurseId <> '')))

-- #8 Collection Minimum Size (UNSAT) in MedicalRecord
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context MedicalRecord
inv: (self.labTests->size() >= 2) and (self.labTests->size() < 2)

-- #9 Boolean Is True (UNSAT) in Patient
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Patient
inv: ((self.isInsured = true) and (self.patientId <> '' and self.patientId.size() > 0)) and (not((self.isInsured = true) and (self.patientId <> '' and self.patientId.size() > 0)))

-- #10 Collection Minimum Size (UNSAT) in Hospital
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Hospital
inv: ((self.wards->size() >= 1) and (self.address.toUpperCase() = 'TEST')) and (self.wards->size() < 1)

-- #11 Boolean Is False (UNSAT) in Bed
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Bed
inv: (((self.isOccupied = false) and (self.room.oclIsTypeOf(Room))) and (self.bedNo.toUpperCase() = 'TEST')) and (not(((self.isOccupied = false) and (self.room.oclIsTypeOf(Room))) and (self.bedNo.toUpperCase() = 'TEST')))

-- #12 Navigation Chain (UNSAT) in Ward
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Ward
inv: (self.hospital.name <> '') and (not(self.hospital.name <> ''))

-- #13 Navigation Chain (UNSAT) in Medication
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Medication
inv: ((self.prescription.record.createdAt <> '') and (self.name.size() <= 85)) and (not((self.prescription.record.createdAt <> '') and (self.name.size() <= 85)))

-- #14 Existential Quantification (exists) (UNSAT) in MedicalRecord
-- Difficulty: difficult
-- Mutation Strategy: self_contradiction
context MedicalRecord
inv: (self.prescriptions->exists(x | x.issuedAt <> '')) and (not(self.prescriptions->exists(x | x.issuedAt <> '')))

