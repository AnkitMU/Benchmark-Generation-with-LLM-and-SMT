-- Benchmark: LibrarySystem / balanced
-- Type: SAT Constraints Only
-- Generated: 2026-10-15T01:57:05.115659
-- Count: 66

-- #1 Association Exists in Book
-- Difficulty: easy
context Book
inv: self.publisher <> null

-- #2 Conditional Existence in Payment
-- Difficulty: easy
context Payment
inv: self.isProcessed implies self.loan <> null

-- #3 Navigation Consistency in Loan
-- Difficulty: easy
context Loan
inv: self.copy.branch = self.branch

-- #4 Navigation Consistency in Reservation
-- Difficulty: easy
context Reservation
inv: self.copy.book = self.book

-- #5 Navigation Consistency in Fine
-- Difficulty: easy
context Fine
inv: self.loan.member = self.member

-- #6 Association Exists in Branch
-- Difficulty: easy
context Branch
inv: self.manager <> null

-- #7 Collection Navigation in Library
-- Difficulty: difficult
context Library
inv: self.members->forAll(x | x.memberId <> '')

-- #8 Collection Navigation in Publisher
-- Difficulty: difficult
context Publisher
inv: self.books->exists(x | x.publishYear < 1000)

-- #9 Collection Navigation in Member
-- Difficulty: difficult
context Member
inv: self.fines->exists(x | x.amount < 100)

-- #10 Navigation Chain in Copy
-- Difficulty: difficult
context Copy
inv: (self.barcode <> '') and (self.loans->forAll(v | v.dueDate <> ''))

-- #11 Navigation Chain in Fine
-- Difficulty: difficult
context Fine
inv: (self.amount < 1000) and (self.payments->forAll(v | v.amount < 50))

-- #12 Collection Size in Range in Branch
-- Difficulty: difficult
context Branch
inv: (self.code <> '') and (self.copies->forAll(v | v.barcode <> ''))

-- #13 Collection Size in Range in Branch
-- Difficulty: difficult
context Branch
inv: (self.code <> '') and (self.reservations->forAll(v | v.expiryDate <> ''))

-- #14 Collection Size in Range in Fine
-- Difficulty: difficult
context Fine
inv: (self.amount >= 2) and (self.payments->forAll(v | v.amount >= 2))

-- #15 Numeric Is Odd in Book
-- Difficulty: difficult
context Book
inv: (self.publishYear <= 1000) and (self.reservations->forAll(v | v.expiryDate <> ''))

-- #16 Numeric Absolute Value Bounded in Book
-- Difficulty: difficult
context Book
inv: (self.pages > 2) and (self.authors->forAll(v | v.name <> ''))

-- #17 Navigation Chain in Librarian
-- Difficulty: medium
context Librarian
inv: (self.managedBranch.library.maxLoanDays >= 5) and (self.level.size() <= 59)

-- #18 Navigation Chain in Staff
-- Difficulty: medium
context Staff
inv: (self.branch.library.maxLoanDays <= 10) and (self.email.indexOf('test') >= 0)

-- #19 Conditional Existence in Payment
-- Difficulty: medium
context Payment
inv: self.isProcessed implies self.fine <> null

-- #20 Navigation Chain in Fine
-- Difficulty: medium
context Fine
inv: (self.member.library.maxLoanDays >= 2) and (self.reason.size() >= 6)

-- #21 Navigation Consistency in Payment
-- Difficulty: medium
context Payment
inv: (self.loan.fine = self.fine) and (self.timestamp <> '' and self.timestamp.size() > 0)

-- #22 Association Exists in Address
-- Difficulty: medium
context Address
inv: (self.member <> null) and (self.branch <> null)

-- #23 Simple Navigation in Loan
-- Difficulty: medium
context Loan
inv: ((self.payment.isProcessed) and (self.returnDate.size() <= 57)) and (self.branch.oclIsTypeOf(Branch))

-- #24 Navigation Chain in Copy
-- Difficulty: medium
context Copy
inv: (self.branch.library.maxLoanDays >= 2) and (self.barcode <> '' and self.barcode.size() > 0)

-- #25 Navigation Consistency in Payment
-- Difficulty: medium
context Payment
inv: (self.fine.member = self.member) and (self.amount >= 0)

-- #26 Navigation Chain in Branch
-- Difficulty: medium
context Branch
inv: (self.address.branch.code <> '') and (self.name.size() >= 8 implies self.name.substring(1, 8) = 'AB')

-- #27 Select (Filter) Operation in Author
-- Difficulty: medium
context Author
inv: self.books->select(x | x.pages > 1)->size() >= 1

-- #28 Collect (Map) Operation in Author
-- Difficulty: medium
context Author
inv: (self.books->collect(x | x.title)->notEmpty()) and (self.name.size() >= 4)

-- #29 Numeric Attribute Bounded in Fine
-- Difficulty: medium
context Fine
inv: self.amount >= 51 and self.amount <= 58

-- #30 Numeric Attribute Positive in Book
-- Difficulty: easy
context Book
inv: self.publishYear > 0

-- #31 Collection Size in Range in Fine
-- Difficulty: medium
context Fine
inv: self.payments->size() >= 1 and self.payments->size() <= 1

-- #32 Numeric Is Even in Library
-- Difficulty: medium
context Library
inv: (self.maxLoanDays mod 2 = 0) and (self.books->size() > 1)

-- #33 Numeric Multiple Of in Library
-- Difficulty: easy
context Library
inv: self.maxLoanDays mod 6 = 0

-- #34 Numeric Less Than Value in Book
-- Difficulty: medium
context Book
inv: ((self.pages < 17) and (self.authors->notEmpty())) and (self.copies->size() > 0)

-- #35 Numeric Multiple Of in Book
-- Difficulty: medium
context Book
inv: (self.publishYear mod 9 = 0) and (self.authors->notEmpty())

-- #36 Numeric Absolute Value Bounded in Book
-- Difficulty: medium
context Book
inv: (self.pages.abs() <= 6) and (self.authors->any(x | x.name <> '') <> null)

-- #37 Numeric Multiple Of in Book
-- Difficulty: easy
context Book
inv: self.pages mod 2 = 0

-- #38 Numeric Is Even in Book
-- Difficulty: medium
context Book
inv: (self.publishYear mod 2 = 0) and (self.authors->collect(x | x.books)->size() >= 2)

-- #39 Numeric Attribute Positive in Fine
-- Difficulty: easy
context Fine
inv: self.amount > 0

-- #40 Collection Size in Range in Author
-- Difficulty: medium
context Author
inv: self.books->size() >= 3 and self.books->size() <= 3

-- #41 Numeric Attribute Non-Negative in Library
-- Difficulty: easy
context Library
inv: self.maxLoanDays >= 0

-- #42 Universal Quantification (forAll) in Member
-- Difficulty: difficult
context Member
inv: self.payments->forAll(x | x.amount > 5)

-- #43 Collection Size Constraint in Author
-- Difficulty: easy
context Author
inv: self.books->size() <> 1

-- #44 Collection Has Specific Size in Branch
-- Difficulty: easy
context Branch
inv: self.reservations->size() = 3

-- #45 Collection Not Empty Check in Book
-- Difficulty: easy
context Book
inv: self.authors->size() > 0

-- #46 Two Attributes Not Equal in Loan
-- Difficulty: easy
context Loan
inv: self.returnDate <> self.startDate

-- #47 Collection Minimum Size in Book
-- Difficulty: easy
context Book
inv: self.copies->size() >= 2

-- #48 Collection Maximum Size in Book
-- Difficulty: easy
context Book
inv: self.reservations->size() <= 3

-- #49 Bi-directional Implication in Loan
-- Difficulty: easy
context Loan
inv: (self.dueDate <> null) = (self.returnDate <> null)

-- #50 Collection Not Empty (Simple) in Author
-- Difficulty: easy
context Author
inv: self.books->notEmpty()

-- #51 Two Attributes Not Equal in Reservation
-- Difficulty: easy
context Reservation
inv: self.requestDate <> self.expiryDate

-- #52 Simple Implication in Reservation
-- Difficulty: easy
context Reservation
inv: self.requestDate <> null implies self.expiryDate <> null

-- #53 Collection Not Empty Check in Branch
-- Difficulty: easy
context Branch
inv: self.reservations->size() > 0

-- #54 All Attributes Defined in Loan
-- Difficulty: easy
context Loan
inv: self.returnDate <> null and self.startDate <> null

-- #55 Simple Implication in Loan
-- Difficulty: medium
context Loan
inv: self.dueDate <> null implies self.returnDate <> null

-- #56 Reverse Implication in Reservation
-- Difficulty: medium
context Reservation
inv: self.expiryDate <> null implies self.requestDate <> null

-- #57 Simple Implication in Loan
-- Difficulty: medium
context Loan
inv: self.startDate <> null implies self.dueDate <> null

-- #58 Three Attributes Defined in Loan
-- Difficulty: medium
context Loan
inv: self.startDate <> null and self.dueDate <> null and self.returnDate <> null

-- #59 Navigation Chain in Book
-- Difficulty: difficult
context Book
inv: (self.pages < 100) and (self.copies->forAll(v | v.barcode <> ''))

-- #60 Numeric Attribute Non-Negative in Fine
-- Difficulty: difficult
context Fine
inv: (self.amount > 0) and (self.payments->forAll(v | v.amount >= 10))

-- #61 Numeric Absolute Value Bounded in Book
-- Difficulty: difficult
context Book
inv: (self.pages > 0) and (self.authors->forAll(v | v.name <> ''))

-- #62 Any Operation in Category
-- Difficulty: difficult
context Category
inv: (self.books->any(x | x.publishYear < 100) <> null) and (self.books->size() <= 3)

-- #63 Flatten Operation in Library
-- Difficulty: difficult
context Library
inv: self.branches->collect(x | x.copies)->flatten()->notEmpty()

-- #64 Flatten Operation in Book
-- Difficulty: difficult
context Book
inv: self.authors->collect(x | x.books)->flatten()->notEmpty()

-- #65 Collection Must Be Empty in Book
-- Difficulty: difficult
context Book
inv: (self.publishYear <= 100) and (self.copies->forAll(v | v.barcode <> ''))

-- #66 Collection Index Of Element in Branch
-- Difficulty: difficult
context Branch
inv: (self.phone <> '') and (self.reservations->forAll(v | v.expiryDate <> ''))

