-- Mutation Strategy: self_contradiction
context Post
inv: ((self.media->any(x | x.mediaType <> '') <> null) and (self.createdAt.size() >= 2 implies self.createdAt.substring(1, 2) = 'AB')) and (not((self.media->any(x | x.mediaType <> '') <> null) and (self.createdAt.size() >= 2 implies self.createdAt.substring(1, 2) = 'AB')))

-- #4 Collection As Sequence Conversion (UNSAT) in User
