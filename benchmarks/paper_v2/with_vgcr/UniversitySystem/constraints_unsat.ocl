-- #1 Numeric Sum Constraint (UNSAT) in Scholarship
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Scholarship
inv: (self.endYear + self.startYear > 71) and (not(self.endYear + self.startYear > 71))

-- #2 Navigation Chain (UNSAT) in GradeRecord
-- Difficulty: unboxed
-- Mutation Strategy: contradictory_bounds
context GradeRecord
inv: ((self.enrollment.student.yearOfStudy >= 2) and (self.letterGrade <> null)) and (self.enrollment.student.yearOfStudy < 2)

-- #3 Existential Quantification (exists) (UNSAT) in Building
-- Difficulty: difficult
-- Mutation Strategy: self_contradiction
context Building
inv: (self.rooms->exists(x | x.capacity <= 1000)) and (not(self.rooms->exists(x | x.capacity <= 1000)))

-- #4 Association Exists (UNSAT) in Enrollment
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Enrollment
inv: (self.grade <> null) and (not(self.grade <> null))

-- #5 Collection Not Empty Check (UNSAT) in CourseOffering
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
