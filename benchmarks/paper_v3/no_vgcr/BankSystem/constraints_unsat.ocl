-- #1 Collection Has Specific Size (UNSAT) in Branch
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Branch
inv: (self.employees->size() = 3) and (self.employees->size() <> 3)

-- #2 Not Both Defined (UNSAT) in Address
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Address
inv: (not(self.city <> null and self.line1 <> null)) and (not(not(self.city <> null and self.line1 <> null)))

-- #3 Reverse Implication (UNSAT) in Address
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Address
inv: (self.city <> null implies self.line1 <> null) and (not(self.city <> null implies self.line1 <> null))

-- #4 Numeric Attribute Positive (UNSAT) in Loan
-- Difficulty: unboxed
-- Mutation Strategy: contradictory_bounds
context Loan
inv: ((self.principal > 0) and (if self.interestRate > self.principal then self.interestRate else self.principal endif >= 16)) and (self.principal < -5)

-- #5 Attribute Not Null (Simple) (UNSAT) in AccountTransaction
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context AccountTransaction
inv: (self.type <> null) and (not(self.type <> null))

-- #6 Numeric Greater Than Value (UNSAT) in SavingsAccount
-- Difficulty: easy
-- Mutation Strategy: contradictory_bounds
context SavingsAccount
inv: (self.interestRate > 32) and (self.interestRate < 27)

-- #7 Collection Not Empty Check (UNSAT) in Bank
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Bank
inv: (self.branches->size() > 0) and (self.branches->size() < -5)

-- #8 Navigation Chain (UNSAT) in Employee
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Employee
inv: (((self.branch.bank.swiftCode <> '') and (self.branch.oclIsTypeOf(Branch))) and (self.name.toLowerCase() = 'test')) and (not(((self.branch.bank.swiftCode <> '') and (self.branch.oclIsTypeOf(Branch))) and (self.name.toLowerCase() = 'test')))

-- #9 Collection As Sequence Conversion (UNSAT) in Branch
-- Difficulty: unboxed
-- Mutation Strategy: universal_negation
context Branch
inv: ((self.city <> '') and (self.employees->forAll(v | v.name <> ''))) and (self.employees->exists(v | not(v.name <> '')))

-- #10 Collection Not Empty (Simple) (UNSAT) in Branch
-- Difficulty: unboxed
-- Mutation Strategy: empty_collection
context Branch
inv: (self.employees->notEmpty()) and (self.employees->isEmpty())

-- #11 Collection Navigation (UNSAT) in Customer
-- Difficulty: difficult
-- Mutation Strategy: self_contradiction
context Customer
inv: (self.loans->exists(x | x.principal >= 1)) and (not(self.loans->exists(x | x.principal >= 1)))

-- #12 Navigation Chain (UNSAT) in Payment
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Payment
inv: (((self.transaction.payment.isConfirmed <> true) and (self.isConfirmed)) and (self.method.toUpperCase() = 'TEST')) and (not(((self.transaction.payment.isConfirmed <> true) and (self.isConfirmed)) and (self.method.toUpperCase() = 'TEST')))

-- #13 Two Attributes Not Equal (UNSAT) in Address
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Address
inv: (self.city <> self.line1) and (not(self.city <> self.line1))

-- #14 Bi-directional Implication (UNSAT) in Address
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Address
inv: ((self.line1 <> null) = (self.country <> null)) and (not((self.line1 <> null) = (self.country <> null)))

-- #15 Collection Maximum Size (UNSAT) in Account
-- Difficulty: unboxed
-- Mutation Strategy: contradictory_bounds
context Account
inv: ((self.transactions->size() <= 3) and (self.balance >= 74 and self.balance <= 94)) and (self.transactions->size() > 3)

