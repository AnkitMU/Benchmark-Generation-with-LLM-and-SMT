-- Benchmark: FlightBooking / balanced
-- Type: SAT Constraints Only
-- Generated: 2026-10-16T06:23:55.911043
-- Count: 53

-- #1 Collection Size in Range in Flight
-- Difficulty: difficult
context Flight
inv: (self.flightNo <> '') and (self.bookings->forAll(v | v.createdAt <> ''))

-- #2 Collection Size in Range in Booking
-- Difficulty: difficult
context Booking
inv: (self.bookingRef <> '') and (self.baggages->forAll(v | v.weightKg < 50))

-- #3 Collection Size in Range in Aircraft
-- Difficulty: difficult
context Aircraft
inv: (self.model <> '') and (self.seats->forAll(v | v.seatNo <> ''))

-- #4 Collection Size in Range in Flight
-- Difficulty: difficult
context Flight
inv: (self.departureTime <> '') and (self.bookings->forAll(v | v.bookingRef <> ''))

-- #5 Collection Size in Range in Flight
-- Difficulty: difficult
context Flight
inv: (self.arrivalTime <> '') and (self.bookings->forAll(v | v.bookingRef <> ''))

-- #6 Simple Navigation in BoardingPass
-- Difficulty: easy
context BoardingPass
inv: self.checkIn.isOnline

-- #7 Conditional Existence in CheckIn
-- Difficulty: easy
context CheckIn
inv: self.isOnline implies self.boardingPass <> null

-- #8 Association Exists in Booking
-- Difficulty: easy
context Booking
inv: self.ticket <> null

-- #9 Navigation Chain in Aircraft
-- Difficulty: easy
context Aircraft
inv: self.airline.code <> ''

-- #10 Navigation Consistency in Flight
-- Difficulty: easy
context Flight
inv: self.aircraft.airline = self.airline

-- #11 Collection Navigation in Passenger
-- Difficulty: difficult
context Passenger
inv: self.bookings->exists(x | x.bookingRef <> '')

-- #12 Collection Navigation in Airport
-- Difficulty: difficult
context Airport
inv: self.departingFlights->exists(x | x.arrivalTime <> '')

-- #13 Collection Navigation in Booking
-- Difficulty: difficult
context Booking
inv: self.baggages->exists(x | x.weightKg <= 50)

-- #14 Collection Navigation in Aircraft
-- Difficulty: difficult
context Aircraft
inv: self.seats->forAll(x | x.seatNo <> '')

-- #15 Navigation Chain in Payment
-- Difficulty: medium
context Payment
inv: (self.booking.flight.departureTime <> '') and (self.amount.abs() <= 6)

-- #16 Navigation Chain in Ticket
-- Difficulty: medium
context Ticket
inv: (self.booking.flight.departureTime <> '') and (self.ticketNo <> null)

-- #17 Navigation Chain in Baggage
-- Difficulty: medium
context Baggage
inv: (self.booking.flight.flightNo <> '') and (self.tagNo <> null)

-- #18 Navigation Chain in Seat
-- Difficulty: medium
context Seat
inv: (self.aircraft.airline.code <> '') and (self.seatNo.size() = 19)

-- #19 Association Exists in BoardingPass
-- Difficulty: medium
context BoardingPass
inv: ((self.seat <> null) and (self.seat.oclIsTypeOf(Seat))) and (self.checkIn.booking.createdAt <> '')

-- #20 Association Exists in BoardingPass
-- Difficulty: medium
context BoardingPass
inv: (self.seat <> null) and (self.barcode.indexOf('test') >= 0)

-- #21 Navigation Chain in Aircraft
-- Difficulty: medium
context Aircraft
inv: (self.airline.code <> '') and (self.seats->size() > 0)

-- #22 Association Exists in BoardingPass
-- Difficulty: medium
context BoardingPass
inv: (self.seat <> null) and (self.barcode.size() >= 19)

-- #23 Navigation Chain in Baggage
-- Difficulty: medium
context Baggage
inv: (self.booking.flight.departureTime <> '') and (self.weightKg.abs() <= 4)

-- #24 Association Exists in BoardingPass
-- Difficulty: medium
context BoardingPass
inv: (self.seat <> null) and (self.gate <> null)

-- #25 Numeric Attribute Bounded in Baggage
-- Difficulty: medium
context Baggage
inv: self.weightKg >= 4 and self.weightKg <= 56

-- #26 Numeric Less Than Value in Payment
-- Difficulty: easy
context Payment
inv: self.amount < 37

-- #27 Numeric Attribute Positive in Baggage
-- Difficulty: medium
context Baggage
inv: (self.weightKg > 0) and (self.tagNo.size() <= 26)

-- #28 Collect (Map) Operation in Airline
-- Difficulty: medium
context Airline
inv: (self.aircrafts->collect(x | x.model)->notEmpty()) and (self.name.toUpperCase() = 'TEST')

-- #29 Any Operation in Aircraft
-- Difficulty: medium
context Aircraft
inv: (self.seats->any(x | x.seatNo <> '') <> null) and (self.airline.oclIsTypeOf(Airline))

-- #30 Select (Filter) Operation in Booking
-- Difficulty: medium
context Booking
inv: self.baggages->select(x | x.weightKg < 100)->size() >= 1

-- #31 Collect (Map) Operation in Booking
-- Difficulty: medium
context Booking
inv: (self.baggages->collect(x | x.weightKg)->notEmpty()) and (self.bookingRef <> '' and self.bookingRef.size() > 0)

-- #32 Existential Quantification (exists) in Airport
-- Difficulty: difficult
context Airport
inv: self.arrivingFlights->exists(x | x.arrivalTime <> '')

-- #33 Existential Quantification (exists) in Aircraft
-- Difficulty: difficult
context Aircraft
inv: self.seats->exists(x | x.seatNo <> '')

-- #34 Collection Nested Collection Flatten in Passenger
-- Difficulty: difficult
context Passenger
inv: (self.bookings->collect(x | x.baggages)->size() >= 2) and (self.fullName.indexOf('test') >= 0)

-- #35 Collection Nested Collection Flatten in Airline
-- Difficulty: difficult
context Airline
inv: (self.flights->collect(x | x.bookings)->size() >= 3) and (self.aircrafts->notEmpty())

-- #36 Collection Size Constraint in Booking
-- Difficulty: easy
context Booking
inv: self.baggages->size() >= 1

-- #37 Collection Not Empty Check in Airline
-- Difficulty: easy
context Airline
inv: self.aircrafts->size() > 0

-- #38 Collection Minimum Size in Aircraft
-- Difficulty: easy
context Aircraft
inv: self.seats->size() >= 2

-- #39 Two Attributes Not Equal in Flight
-- Difficulty: easy
