-- #45 All Attributes Defined in Flight
-- Difficulty: medium
context Flight
inv: self.arrivalTime <> null and self.departureTime <> null

-- #46 All Attributes Defined in Flight
-- Difficulty: medium
context Flight
inv: self.departureTime <> null and self.arrivalTime <> null

-- #47 Bi-directional Implication in Flight
-- Difficulty: medium
context Flight
inv: (self.arrivalTime <> null) = (self.departureTime <> null)

-- #48 Simple Implication in Flight
-- Difficulty: medium
context Flight
inv: self.departureTime <> null implies self.arrivalTime <> null

-- #49 Association Exists in Booking
-- Difficulty: easy
context Booking
inv: self.payment <> null

-- #50 Collection Navigation in Airline
-- Difficulty: difficult
context Airline
inv: self.flights->forAll(x | x.departureTime <> '')

-- #51 Universal Quantification (forAll) in Booking
-- Difficulty: difficult
context Booking
inv: self.baggages->forAll(x | x.weightKg > 0)

-- #52 One Operation in Airline
-- Difficulty: difficult
