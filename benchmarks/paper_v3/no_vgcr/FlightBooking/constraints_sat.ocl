inv: (self.departureTime <> null) = (self.arrivalTime <> null)

-- #43 Simple Implication in Flight
-- Difficulty: easy
context Flight
inv: self.arrivalTime <> null implies self.departureTime <> null

-- #44 Collection Not Empty Check in Aircraft
-- Difficulty: easy
