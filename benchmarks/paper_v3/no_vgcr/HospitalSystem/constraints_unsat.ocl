-- Benchmark: HospitalSystem / balanced
-- Type: UNSAT Constraints Only
-- Generated: 2026-10-16T06:27:26.205555
-- Count: 13

-- #1 Collection Navigation (UNSAT) in Hospital
-- Difficulty: difficult
-- Mutation Strategy: self_contradiction
context Hospital
inv: (self.departments->exists(x | x.name <> '')) and (not(self.departments->exists(x | x.name <> '')))

-- #2 Numeric Greater Than Value (UNSAT) in Ward
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Ward
inv: (self.floor > 14) and (self.floor < 9)

-- #3 Boolean Is False (UNSAT) in Bed
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Bed
inv: ((self.isOccupied = false) and (self.bedNo.size() <= 22)) and (not((self.isOccupied = false) and (self.bedNo.size() <= 22)))

-- #4 Collection Size Constraint (UNSAT) in MedicalRecord
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context MedicalRecord
inv: (self.prescriptions->size() <> 1) and (not(self.prescriptions->size() <> 1))

-- #5 Collection Maximum Size (UNSAT) in Doctor
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Doctor
inv: (self.appointments->size() <= 3) and (self.appointments->size() > 3)

-- #6 Collection Navigation (UNSAT) in Department
-- Difficulty: difficult
-- Mutation Strategy: universal_negation
context Department
inv: (self.doctors->forAll(x | x.specialty <> '')) and (self.doctors->exists(x | not(x.specialty <> '')))

-- #7 Simple Navigation (UNSAT) in Appointment
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Appointment
inv: (self.patient.isInsured) and (not(self.patient.isInsured))

-- #8 Numeric Attribute Positive (UNSAT) in Invoice
-- Difficulty: easy
-- Mutation Strategy: contradictory_bounds
context Invoice
inv: (self.totalAmount > 0) and (self.totalAmount < -5)

-- #9 Collection Size in Range (UNSAT) in Room
-- Difficulty: unboxed
-- Mutation Strategy: universal_negation
context Room
inv: ((self.roomNo <> '') and (self.beds->forAll(v | v.isOccupied <> true))) and (self.beds->exists(v | not(v.isOccupied <> true)))

-- #10 Any Operation (UNSAT) in Department
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Department
inv: ((self.nurses->any(x | x.nurseId <> '') <> null) and (self.nurses->exists(x | x.shift <> ''))) and (not((self.nurses->any(x | x.nurseId <> '') <> null) and (self.nurses->exists(x | x.shift <> ''))))

-- #11 Association Exists (UNSAT) in Admission
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Admission
inv: (self.discharge <> null) and (not(self.discharge <> null))

-- #12 Existential Quantification (exists) (UNSAT) in Department
-- Difficulty: difficult
-- Mutation Strategy: self_contradiction
context Department
inv: (self.nurses->exists(x | x.nurseId <> '')) and (not(self.nurses->exists(x | x.nurseId <> '')))

-- #13 Numeric Less Than Value (UNSAT) in Payment
-- Difficulty: easy
-- Mutation Strategy: contradictory_bounds
context Payment
inv: (self.amount < 41) and (self.amount > 46)

