-- Benchmark: ManufacturingPlant / balanced
-- Type: SAT Constraints Only
-- Generated: 2026-10-16T06:31:27.578871
-- Count: 60

-- #1 Navigation Chain in InventoryItem
-- Difficulty: easy
context InventoryItem
inv: self.plant.location <> ''

-- #2 Simple Navigation in WorkOrder
-- Difficulty: easy
context WorkOrder
inv: self.line.isActive

-- #3 Navigation Chain in Technician
-- Difficulty: easy
context Technician
inv: self.shift.startTime <> ''

-- #4 Navigation Chain in Shipment
-- Difficulty: easy
context Shipment
inv: self.supplier.supplierId <> ''

-- #5 Association Exists in Product
-- Difficulty: easy
context Product
inv: self.bom <> null

-- #6 Association Exists in Operator
-- Difficulty: easy
context Operator
inv: self.shift <> null

-- #7 Conditional Existence in MaintenanceTask
-- Difficulty: easy
context MaintenanceTask
inv: self.isDone implies self.assignedTo <> null

-- #8 Simple Navigation in DefectReport
-- Difficulty: easy
context DefectReport
inv: self.qualityCheck.passed

-- #9 Association Exists in BOMItem
-- Difficulty: easy
context BOMItem
inv: self.inventoryItem <> null

-- #10 Collection Size in Range in ProductionLine
-- Difficulty: difficult
context ProductionLine
inv: (self.isActive <> false) and (self.workOrders->forAll(v | v.plannedQuantity <= 100))

-- #11 Collection Size in Range in BillOfMaterials
-- Difficulty: difficult
context BillOfMaterials
inv: (self.bomId <> '') and (self.items->forAll(v | v.requiredQty <= 10))

-- #12 Numeric Attribute Bounded in WorkOrder
-- Difficulty: difficult
context WorkOrder
inv: (self.plannedQuantity >= 1) and (self.qualityChecks->forAll(v | v.passed = true))

-- #13 Numeric Is Odd in WorkOrder
-- Difficulty: difficult
context WorkOrder
inv: (self.plannedQuantity > 1) and (self.qualityChecks->forAll(v | v.passed = true))

-- #14 Collection Navigation in Shift
-- Difficulty: difficult
context Shift
inv: self.operators->exists(x | x.name <> '')

-- #15 Collection Navigation in Plant
-- Difficulty: difficult
context Plant
inv: self.inventory->exists(x | x.quantity >= 5)

-- #16 Collection Navigation in Supplier
-- Difficulty: difficult
context Supplier
inv: self.items->forAll(x | x.quantity < 10)

-- #17 Collection Navigation in QualityCheck
-- Difficulty: difficult
context QualityCheck
inv: self.defects->forAll(x | x.severity > 0)

-- #18 Collection Navigation in Machine
-- Difficulty: difficult
context Machine
inv: self.sensors->forAll(x | x.lastReading <= 100)

-- #19 Simple Navigation in DefectReport
-- Difficulty: medium
context DefectReport
inv: (self.qualityCheck.passed) and (self.defectId.indexOf('test') >= 0)

-- #20 Navigation Chain in InventoryItem
-- Difficulty: medium
context InventoryItem
inv: (self.plant.name <> '') and (self.quantity mod 4 = 0)

-- #21 Navigation Chain in InventoryItem
-- Difficulty: medium
context InventoryItem
inv: (self.plant.location <> '') and (self.name.toLowerCase() = 'test')

-- #22 Simple Navigation in DefectReport
-- Difficulty: medium
context DefectReport
inv: (self.qualityCheck.passed) and (self.description <> '' and self.description.size() > 0)

-- #23 Simple Navigation in Workstation
-- Difficulty: medium
context Workstation
inv: ((self.line.isActive) and (self.stationId.size() >= 20)) and (self.machines->size() = 2)

-- #24 Association Exists in BOMItem
-- Difficulty: medium
context BOMItem
inv: (self.inventoryItem <> null) and (self.name.toUpperCase() = 'TEST')

-- #25 Simple Navigation in DefectReport
-- Difficulty: medium
context DefectReport
inv: ((self.qualityCheck.passed) and (self.severity >= 0)) and (self.defectId.toUpperCase() = 'TEST')

-- #26 Select (Filter) Operation in Machine
-- Difficulty: medium
context Machine
inv: self.sensors->select(x | x.lastReading <= 10)->size() >= 1

-- #27 Collect (Map) Operation in Machine
-- Difficulty: medium
context Machine
inv: (self.maintenanceTasks->collect(x | x.taskId)->notEmpty()) and (self.maintenanceTasks->size() <= 3)

-- #28 Any Operation in Machine
-- Difficulty: medium
context Machine
inv: (self.sensors->any(x | x.lastReading >= 2) <> null) and (self.serialNumber.toLowerCase() = 'test')

-- #29 One Operation in ProductionLine
-- Difficulty: medium
context ProductionLine
inv: (self.stations->one(x | x.name <> '')) and (self.lineId.toLowerCase() = 'test')

-- #30 Collect (Map) Operation in Plant
-- Difficulty: medium
context Plant
inv: (self.workshops->collect(x | x.code)->notEmpty()) and (self.suppliers->isEmpty())

-- #31 Numeric Multiple Of in BOMItem
-- Difficulty: medium
context BOMItem
inv: (self.requiredQty mod 5 = 0) and (self.requiredQty mod 2 = 0)

-- #32 Numeric Is Even in BOMItem
-- Difficulty: easy
context BOMItem
inv: self.requiredQty mod 2 = 0

-- #33 Numeric Attribute Bounded in DefectReport
-- Difficulty: medium
context DefectReport
inv: self.severity >= 45 and self.severity <= 55

-- #34 Numeric Is Even in DefectReport
-- Difficulty: medium
context DefectReport
inv: (self.severity mod 2 = 0) and (self.qualityCheck.oclIsTypeOf(QualityCheck))

-- #35 Numeric Is Odd in WorkOrder
-- Difficulty: easy
context WorkOrder
inv: self.plannedQuantity mod 2 = 1

-- #36 Numeric Attribute Positive in InventoryItem
-- Difficulty: easy
context InventoryItem
inv: self.quantity > 0

-- #37 Collection Size in Range in ProductionLine
-- Difficulty: medium
context ProductionLine
inv: self.workOrders->size() >= 3 and self.workOrders->size() <= 3

-- #38 Numeric Attribute Non-Negative in DefectReport
-- Difficulty: easy
context DefectReport
inv: self.severity >= 0

-- #39 Universal Quantification (forAll) in ProductionLine
-- Difficulty: difficult
context ProductionLine
inv: self.workOrders->forAll(x | x.plannedQuantity <= 50)

-- #40 Existential Quantification (exists) in Plant
-- Difficulty: difficult
context Plant
inv: self.workshops->exists(x | x.name <> '')

-- #41 Existential Quantification (exists) in QualityCheck
-- Difficulty: difficult
context QualityCheck
inv: self.defects->exists(x | x.severity >= 2)

-- #42 Flatten Operation in WorkOrder
-- Difficulty: difficult
context WorkOrder
inv: self.qualityChecks->collect(x | x.defects)->flatten()->notEmpty()

-- #43 Flatten Operation in Workshop
-- Difficulty: difficult
context Workshop
inv: self.lines->collect(x | x.workOrders)->flatten()->notEmpty()

-- #44 Attribute Not Null (Simple) in Robot
-- Difficulty: easy
context Robot
inv: self.isCalibrated <> null

-- #45 Collection Size Constraint in Plant
-- Difficulty: easy
context Plant
inv: self.suppliers->size() < 1

-- #46 Collection Has Specific Size in Plant
-- Difficulty: easy
context Plant
inv: self.workshops->size() = 2

-- #47 Collection Not Empty Check in Plant
-- Difficulty: easy
context Plant
inv: self.workshops->size() > 0

-- #48 Collection Size Constraint in Plant
-- Difficulty: easy
context Plant
inv: self.suppliers->size() <> 1

-- #49 Bi-directional Implication in Shift
-- Difficulty: easy
context Shift
inv: (self.startTime <> null) = (self.endTime <> null)

-- #50 Collection Not Empty Check in Plant
-- Difficulty: easy
context Plant
inv: self.inventory->size() > 0

-- #51 Collection Maximum Size in Machine
-- Difficulty: easy
context Machine
inv: self.sensors->size() <= 2

-- #52 Bi-directional Implication in Shift
-- Difficulty: easy
context Shift
inv: (self.endTime <> null) = (self.startTime <> null)

-- #53 Reverse Implication in Shift
-- Difficulty: medium
context Shift
inv: self.startTime <> null implies self.endTime <> null

-- #54 Simple Implication in Shift
-- Difficulty: medium
context Shift
inv: self.endTime <> null implies self.startTime <> null

-- #55 All Attributes Defined in Shift
-- Difficulty: medium
context Shift
inv: self.startTime <> null and self.endTime <> null

-- #56 Association Exists in Workstation
-- Difficulty: easy
context Workstation
inv: self.assignedOperator <> null

-- #57 Navigation Chain in InventoryItem
-- Difficulty: easy
context InventoryItem
inv: self.plant.name <> ''

-- #58 One Operation in Machine
-- Difficulty: difficult
context Machine
inv: (self.sensors->one(x | x.lastReading <= 100)) and (self.sensors->exists(x | x.lastReading >= 1))

-- #59 Collection Size Constraint in WorkOrder
-- Difficulty: difficult
context WorkOrder
inv: (self.plannedQuantity <= 100) and (self.qualityChecks->forAll(v | v.passed <> false))

-- #60 Collection Not Empty (Simple) in Workshop
-- Difficulty: difficult
context Workshop
inv: (self.name <> '') and (self.lines->forAll(v | v.isActive = true))

