-- Mutation Strategy: self_contradiction
context ProductionLine
inv: ((self.workOrders->collect(x | x.qualityChecks)->size() >= 3) and (self.stations->exists(x | x.name <> ''))) and (not((self.workOrders->collect(x | x.qualityChecks)->size() >= 3) and (self.stations->exists(x | x.name <> ''))))

-- #3 Select (Filter) Operation (UNSAT) in BillOfMaterials
