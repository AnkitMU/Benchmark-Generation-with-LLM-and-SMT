context Plant
inv: ((self.inventory->any(x | x.quantity < 100) <> null) and (self.suppliers->isEmpty())) and (not((self.inventory->any(x | x.quantity < 100) <> null) and (self.suppliers->isEmpty())))

-- #5 Collection As Sequence Conversion (UNSAT) in Machine
