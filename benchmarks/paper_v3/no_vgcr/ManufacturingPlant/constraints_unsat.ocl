inv: (self.items->select(x | x.requiredQty >= 5)->size() >= 1) and (not(self.items->select(x | x.requiredQty >= 5)->size() >= 1))

-- #4 Any Operation (UNSAT) in Plant
-- Difficulty: unboxed
