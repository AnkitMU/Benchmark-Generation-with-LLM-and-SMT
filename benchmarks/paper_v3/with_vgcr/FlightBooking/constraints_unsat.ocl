-- Benchmark: FlightBooking / balanced
-- Type: UNSAT Constraints Only
-- Generated: 2026-10-16T03:06:46.223572
-- Count: 16

-- #1 Flatten Operation (UNSAT) in Airport
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Airport
inv: (self.arrivingFlights->collect(x | x.bookings)->flatten()->notEmpty()) and (not(self.arrivingFlights->collect(x | x.bookings)->flatten()->notEmpty()))

-- #2 Collection Size in Range (UNSAT) in Flight
-- Difficulty: unboxed
-- Mutation Strategy: universal_negation
context Flight
inv: ((self.arrivalTime <> '') and (self.bookings->forAll(v | v.bookingRef <> ''))) and (self.bookings->exists(v | not(v.bookingRef <> '')))

-- #3 Collection Size Constraint (UNSAT) in Flight
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Flight
inv: (self.bookings->size() <> 1) and (not(self.bookings->size() <> 1))

-- #4 Collection Size in Range (UNSAT) in Aircraft
-- Difficulty: unboxed
-- Mutation Strategy: universal_negation
context Aircraft
inv: ((self.registrationNo <> '') and (self.seats->forAll(v | v.seatNo <> ''))) and (self.seats->exists(v | not(v.seatNo <> '')))

-- #5 Association Exists (UNSAT) in BoardingPass
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context BoardingPass
inv: ((self.seat <> null) and (self.barcode.size() >= 19)) and (not((self.seat <> null) and (self.barcode.size() >= 19)))

-- #6 Simple Implication (UNSAT) in Flight
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Flight
inv: (self.departureTime <> null implies self.arrivalTime <> null) and (not(self.departureTime <> null implies self.arrivalTime <> null))

-- #7 Simple Implication (UNSAT) in Flight
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Flight
inv: (self.arrivalTime <> null implies self.departureTime <> null) and (not(self.arrivalTime <> null implies self.departureTime <> null))

-- #8 Collection Maximum Size (UNSAT) in Booking
-- Difficulty: unboxed
-- Mutation Strategy: universal_negation
context Booking
inv: ((self.createdAt <> '') and (self.baggages->forAll(v | v.weightKg <= 100))) and (self.baggages->exists(v | not(v.weightKg <= 100)))

-- #9 Collection Nested Collection Flatten (UNSAT) in Airline
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Airline
inv: ((self.flights->collect(x | x.bookings)->size() >= 3) and (self.aircrafts->notEmpty())) and (not((self.flights->collect(x | x.bookings)->size() >= 3) and (self.aircrafts->notEmpty())))

-- #10 Collection Navigation (UNSAT) in Airline
-- Difficulty: difficult
-- Mutation Strategy: universal_negation
context Airline
inv: (self.flights->forAll(x | x.departureTime <> '')) and (self.flights->exists(x | not(x.departureTime <> '')))

-- #11 Numeric Less Than Value (UNSAT) in Payment
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Payment
inv: ((self.amount < 12) and (self.amount > 0)) and (self.amount > 17)

-- #12 One Operation (UNSAT) in Airline
-- Difficulty: unboxed
-- Mutation Strategy: contradictory_bounds
context Airline
inv: ((self.aircrafts->one(x | x.registrationNo <> '')) and (self.flights->size() >= 2 and self.flights->size() <= 3)) and (self.flights->size() < 2)

-- #13 Numeric Less Than Value (UNSAT) in Baggage
-- Difficulty: easy
-- Mutation Strategy: contradictory_bounds
context Baggage
inv: (self.weightKg < 66) and (self.weightKg > 71)

-- #14 Collection Navigation (UNSAT) in Passenger
-- Difficulty: difficult
-- Mutation Strategy: self_contradiction
context Passenger
inv: (self.bookings->exists(x | x.bookingRef <> '')) and (not(self.bookings->exists(x | x.bookingRef <> '')))

-- #15 Navigation Chain (UNSAT) in Seat
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Seat
inv: ((self.aircraft.airline.code <> '') and (self.seatNo.size() = 19)) and (not((self.aircraft.airline.code <> '') and (self.seatNo.size() = 19)))

-- #16 Collect (Map) Operation (UNSAT) in Airline
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Airline
inv: ((self.aircrafts->collect(x | x.model)->notEmpty()) and (self.name.toUpperCase() = 'TEST')) and (not((self.aircrafts->collect(x | x.model)->notEmpty()) and (self.name.toUpperCase() = 'TEST')))

