-- Benchmark: ManufacturingPlant / balanced
-- Type: UNSAT Constraints Only
-- Generated: 2026-10-16T03:46:50.603615
-- Count: 18

-- #1 Collection Maximum Size (UNSAT) in Machine
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Machine
inv: (self.maintenanceTasks->size() <= 1) and (self.maintenanceTasks->size() > 1)

-- #2 Collection Size in Range (UNSAT) in ProductionLine
-- Difficulty: unboxed
-- Mutation Strategy: contradictory_bounds
context ProductionLine
inv: (self.workOrders->size() >= 3 and self.workOrders->size() <= 3) and (self.workOrders->size() < 3)

-- #3 Collection Size Constraint (UNSAT) in Plant
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Plant
inv: (self.suppliers->size() <> 1) and (not(self.suppliers->size() <> 1))

-- #4 Association Exists (UNSAT) in BOMItem
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context BOMItem
inv: (self.inventoryItem <> null) and (not(self.inventoryItem <> null))

-- #5 Numeric Is Odd (UNSAT) in WorkOrder
-- Difficulty: difficult
-- Mutation Strategy: contradictory_bounds
context WorkOrder
inv: ((self.plannedQuantity > 1) and (self.qualityChecks->forAll(v | v.passed = true))) and (self.plannedQuantity < -4)

-- #6 Collection Not Empty Check (UNSAT) in Plant
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Plant
inv: (self.workshops->size() > 0) and (self.workshops->size() < -5)

-- #7 Navigation Chain (UNSAT) in Technician
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Technician
inv: (self.shift.startTime <> '') and (not(self.shift.startTime <> ''))

-- #8 Select (Filter) Operation (UNSAT) in BillOfMaterials
-- Difficulty: difficult
-- Mutation Strategy: self_contradiction
context BillOfMaterials
inv: (self.items->select(x | x.requiredQty >= 5)->size() >= 1) and (not(self.items->select(x | x.requiredQty >= 5)->size() >= 1))

-- #9 Collection Has Specific Size (UNSAT) in Plant
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context Plant
inv: (self.inventory->size() = 2) and (self.inventory->size() <> 2)

-- #10 Collection Size in Range (UNSAT) in ProductionLine
-- Difficulty: unboxed
-- Mutation Strategy: universal_negation
context ProductionLine
inv: ((self.isActive <> false) and (self.workOrders->forAll(v | v.plannedQuantity <= 100))) and (self.workOrders->exists(v | not(v.plannedQuantity <= 100)))

-- #11 Collection Minimum Size (UNSAT) in BillOfMaterials
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context BillOfMaterials
inv: (self.items->size() >= 2) and (self.items->size() < 2)

-- #12 Association Exists (UNSAT) in Product
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Product
inv: (self.bom <> null) and (not(self.bom <> null))

-- #13 Two Attributes Not Equal (UNSAT) in Shift
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context Shift
inv: (self.startTime <> self.endTime) and (not(self.startTime <> self.endTime))

-- #14 Numeric Is Odd (UNSAT) in WorkOrder
-- Difficulty: medium
-- Mutation Strategy: self_contradiction
context WorkOrder
inv: (self.plannedQuantity mod 2 = 1) and (not(self.plannedQuantity mod 2 = 1))

-- #15 Collection Size in Range (UNSAT) in ProductionLine
-- Difficulty: unboxed
-- Mutation Strategy: universal_negation
context ProductionLine
inv: ((self.isActive = true) and (self.workOrders->forAll(v | v.plannedQuantity >= 5))) and (self.workOrders->exists(v | not(v.plannedQuantity >= 5)))

-- #16 Boolean Guard (UNSAT) in Robot
-- Difficulty: easy
-- Mutation Strategy: self_contradiction
context Robot
inv: (self.isCalibrated) and (not(self.isCalibrated))

-- #17 Collect (Map) Operation (UNSAT) in Plant
-- Difficulty: unboxed
-- Mutation Strategy: self_contradiction
context Plant
inv: ((self.workshops->collect(x | x.code)->notEmpty()) and (self.suppliers->isEmpty())) and (not((self.workshops->collect(x | x.code)->notEmpty()) and (self.suppliers->isEmpty())))

-- #18 Collection Minimum Size (UNSAT) in BillOfMaterials
-- Difficulty: medium
-- Mutation Strategy: contradictory_bounds
context BillOfMaterials
inv: (self.items->size() >= 3) and (self.items->size() < 3)

