model CarRental

enum VehicleStatus {Available, Rented, Maintenance}

class Vehicle
attributes
  vin : String
  category : String
  year : Integer
  seats : Integer
  doors : Integer
  horsepower : Integer
  mileage : Integer
  tankLevel : Integer
  weightKg : Integer
  dailyRate : Integer
  purchasePrice : Integer
  insuranceValue : Integer
  isAvailable : Boolean
  status : VehicleStatus
end

class Company
attributes
  name : String
  isActive : Boolean
end

class Payment
attributes
  amount : Integer
  tax : Integer
  discount : Integer
  timestamp : String
  isProcessed : Boolean
end

class Customer
attributes
  name : String
  age : Integer
  rentalCount : Integer
  loyaltyPoints : Integer
  balance : Integer
  depositAmount : Integer
  isPremium : Boolean
end

class Rental
attributes
  startDate : String
  endDate : String
  mileageStart : Integer
  mileageEnd : Integer
  daysRented : Integer
  totalAmount : Integer
  lateFee : Integer
  depositPaid : Integer
  fuelCharge : Integer
  isCompleted : Boolean
end

class Branch
attributes
  name : String
  address : String
  capacity : Integer
  vehicleCount : Integer
  staffCount : Integer
  latitude : Integer
  longitude : Integer
  monthlyRevenue : Integer
  isOpen : Boolean
end

class Reservation
attributes
  dateFrom : String
  dateTo : String
  createdAt : String
  confirmedAt : String
  estimatedCost : Integer
  isConfirmed : Boolean
end

class License
attributes
  number : String
  expiry : String
  isValid : Boolean
end

association Vehicle_branch between
  Vehicle[0..*] role vehicles
  Branch[1] role branch
end

association Vehicle_rentals between
  Vehicle[1] role vehicle
  Rental[0..*] role rentals
end

association Vehicle_reservations between
  Vehicle[0..1] role vehicle
  Reservation[0..*] role reservations
end

association Company_branches between
  Company[1] role company
  Branch[0..*] role branches
end

association Payment_rental between
  Payment[0..1] role payment
  Rental[1] role rental
end

association Customer_license between
  Customer[1] role customer
  License[1] role license
end

association Customer_rentals between
  Customer[1] role customer
  Rental[0..*] role rentals
end

association Customer_reservations between
  Customer[1] role customer
  Reservation[0..*] role reservations
end

association Rental_branch between
  Rental[0..*] role rentals
  Branch[1] role branch
end

association Branch_reservations between
  Branch[1] role branch
  Reservation[0..*] role reservations
end

constraints
context Customer inv c000: self.license <> null
context Vehicle inv c002: self.branch <> null
context Reservation inv c003: (self.customer <> null) and (self.estimatedCost < 16)
context Rental inv c004: self.payment <> null
context Branch inv c005: (self.company <> null) and (self.staffCount <> self.capacity)
context Vehicle inv c007: (self.branch <> null) and (self.seats >= 0)
context License inv c008: self.customer <> null
context Rental inv c009: self.vehicle <> null
context Payment inv c010: self.rental.isCompleted
context Branch inv c011: self.company.isActive
context Customer inv c012: self.license.isValid
context Branch inv c013: self.company.isActive <> false
context Rental inv c014: self.vehicle.isAvailable
context Branch inv c015: self.company.isActive = true
context Reservation inv c016: self.branch.isOpen
context License inv c017: self.customer.isPremium
context Rental inv c018: self.payment.isProcessed
context Company inv c019: self.branches->forAll(x | x.longitude >= 1)
context Customer inv c021: self.reservations->forAll(x | x.estimatedCost >= 2)
context License inv c023: self.customer.license.isValid <> false
context License inv c024: (self.customer.license.isValid = true) and (self.number <> null)
context Customer inv c025: self.license.customer.age <= 1000
context Customer inv c026: self.license.customer.rentalCount >= 0
context Customer inv c027: self.license.customer.balance >= 0
context Payment inv c028: self.rental.branch.monthlyRevenue <= 50
context Customer inv c029: self.license.customer.balance >= 1
context Company inv c030: self.branches->select(x | x.longitude <= 1000)->size() >= 1
context Branch inv c031: (self.longitude > 0) and (self.vehicles->forAll(v | v.dailyRate >= 0))
context Customer inv c032: (self.rentalCount <= 10) and (self.rentals->forAll(v | v.depositPaid <= 1000))
context Vehicle inv c033: (self.purchasePrice <= 10) and (self.rentals->forAll(v | v.totalAmount > 1))
context Vehicle inv c034: self.reservations->collect(x | x.estimatedCost)->sum() >= 3
context Company inv c035: self.branches->collect(x | x.reservations)->size() >= 3
context Branch inv c036: self.vehicles->collect(x | x.reservations)->flatten()->notEmpty()
context Vehicle inv c037: self.rentals->collect(x | x.lateFee)->sum() >= 7
context Rental inv c038: self.lateFee + self.totalAmount > 15
context Rental inv c039: self.mileageStart < self.mileageEnd
context Vehicle inv c040: self.seats - self.doors >= 2
context Rental inv c041: self.mileageEnd >= self.mileageStart
context Customer inv c042: self.depositAmount - self.balance >= 7
context Branch inv c043: self.staffCount.mod(2) = 0
context Branch inv c044: self.capacity.mod(2) = 1
context Rental inv c045: self.daysRented.mod(5) = 0
context Rental inv c046: self.depositPaid.abs() <= 5
context Customer inv c047: self.balance <> self.depositAmount
context Customer inv c048: self.reservations->size() <> 1
context Company inv c049: self.branches->size() = 2
context Branch inv c050: self.reservations->size() >= 1
context Branch inv c051: self.rentals->size() > 0
context Rental inv c052: self.isCompleted = false
context Branch inv c053: self.vehicles->size() = 2
context Branch inv c054: self.vehicles->size() > 0
context Branch inv c055: self.rentals->notEmpty()
context Company inv c056: self.branches->size() > 1
context Branch inv c057: if self.vehicleCount < self.capacity then self.vehicleCount else self.capacity endif >= 49
context Customer inv c058: self.balance.abs() <= 8
context Payment inv c059: self.amount.abs() <= 9
context Payment inv c060: self.discount <= self.amount and self.amount <= self.tax
context Branch inv c061: self.vehicles->size() <= 2
context Vehicle inv c062: self.rentals->size() >= 3
context Payment inv c063: self.discount <> null and self.tax <> null
context Payment inv c064: self.discount <> null implies self.amount <> null
context Branch inv c065: self.rentals->size() >= 2
context Branch inv c066: self.reservations->size() >= 2
context Rental inv c067: (self.totalAmount <> null) = (self.depositPaid <> null)
context Reservation inv c068: self.createdAt <> null and self.confirmedAt <> null
context Branch inv c069: (self.monthlyRevenue >= 2) and (self.rentals->forAll(v | v.fuelCharge <= 1000))
context Branch inv c070: self.reservations->exists(x | x.estimatedCost >= 10)
context Branch inv c071: (self.latitude <= 100) and (self.vehicles->forAll(v | v.mileage < 50))
context Customer inv c072: (self.loyaltyPoints <= 50) and (self.reservations->forAll(v | v.estimatedCost <= 1000))
context Customer inv c073: (self.rentalCount > 0) and (self.reservations->forAll(v | v.estimatedCost < 10))
context Branch inv c074: (self.staffCount <= 10) and (self.vehicles->forAll(v | v.tankLevel < 10))
context Branch inv c075: (self.capacity <= 100) and (self.rentals->forAll(v | v.depositPaid < 50))
context Branch inv c076: self.vehicleCount.abs() <= 0
context Branch inv c077: self.vehicleCount <= self.staffCount and self.staffCount <= self.capacity
