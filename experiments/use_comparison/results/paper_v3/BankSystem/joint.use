model BankSystem

enum AccountStatus {Active, Frozen, Closed}
enum LoanStatus {Requested, Approved, Rejected, Closed}

class Payment
attributes
  method : String
  isConfirmed : Boolean
end

class CardTransaction
attributes
  merchant : String
end

class KYCRecord
attributes
  idNumber : String
  verifiedAt : String
  isVerified : Boolean
end

class Account
attributes
  accountNo : String
  balance : Integer
  status : AccountStatus
end

class Employee
attributes
  employeeId : String
  name : String
end

class Customer
attributes
  customerId : String
  fullName : String
  email : String
end

class Bank
attributes
  name : String
  swiftCode : String
end

class SavingsAccount
attributes
  interestRate : Integer
end

class CheckingAccount
attributes
  overdraftLimit : Integer
end

class Loan
attributes
  loanId : String
  principal : Integer
  interestRate : Integer
  status : LoanStatus
end

class Manager
attributes
  level : String
end

class AccountTransaction
attributes
  type : String
end

class Transaction
attributes
  txnId : String
  amount : Integer
  timestamp : String
end

class Branch
attributes
  branchCode : String
  city : String
end

class CreditCard
attributes
  cardNo : String
  limit : Integer
  isActive : Boolean
end

class Address
attributes
  line1 : String
  city : String
  country : String
  postalCode : String
end

class Teller
attributes
  counterNo : Integer
end

association Payment_transaction between
  Payment[0..1] role payment
  Transaction[1] role transaction
end

association CardTransaction_card between
  CardTransaction[0..*] role cardTransactions
  CreditCard[1] role card
end

association KYCRecord_customer between
  KYCRecord[0..1] role kyc
  Customer[1] role customer
end

association Account_customer between
  Account[0..*] role accounts
  Customer[1] role customer
end

association Account_transactions between
  Account[0..1] role account
  Transaction[0..*] role transactions
end

association Employee_branch between
  Employee[0..*] role employees
  Branch[1] role branch
end

association Customer_branch between
  Customer[0..*] role customers
  Branch[1] role branch
end

association Customer_address between
  Customer[1] role customer
  Address[0..1] role address
end

association Customer_loans between
  Customer[1] role customer
  Loan[0..*] role loans
end

association Customer_cards between
  Customer[1] role customer
  CreditCard[0..*] role cards
end

association Bank_branches between
  Bank[1] role bank
  Branch[0..*] role branches
end

constraints
context Customer inv c000: self.kyc.isVerified
context Transaction inv c001: self.payment <> null
context Branch inv c002: self.bank.name <> ''
context CardTransaction inv c003: self.card.isActive
context Transaction inv c004: self.payment.isConfirmed
context Customer inv c005: self.kyc <> null
context Branch inv c006: self.bank.swiftCode <> ''
context Bank inv c007: self.branches->forAll(x | x.city <> '')
context Account inv c008: self.transactions->forAll(x | x.amount <= 10)
context CreditCard inv c009: (self.limit <= 50) and (self.cardTransactions->forAll(v | v.merchant <> ''))
context Customer inv c010: self.loans->exists(x | x.principal >= 1)
context Bank inv c011: self.branches->exists(x | x.branchCode <> '')
context Address inv c012: (self.customer.branch.branchCode <> '') and (self.country = self.line1)
context KYCRecord inv c013: (self.customer.branch.city <> '') and (self.idNumber <> null)
context Customer inv c016: (self.kyc.isVerified) and (self.loans->select(x | x.principal < 50)->size() >= 1)
context CreditCard inv c019: (self.limit > 2) and (self.cardTransactions->forAll(v | v.merchant <> ''))
context CreditCard inv c020: (self.limit <= 1000) and (self.cardTransactions->forAll(v | v.merchant <> ''))
context Account inv c021: (self.balance <= 10) and (self.transactions->forAll(v | v.amount >= 10))
context Customer inv c022: self.cards->select(x | x.limit < 50)->size() >= 1
context Account inv c023: (self.transactions->collect(x | x.timestamp)->notEmpty()) and (self.transactions->size() = 2)
context Customer inv c024: self.loans->select(x | x.interestRate < 1000)->size() >= 1
context Customer inv c027: self.loans->forAll(x | x.principal <= 50)
context Branch inv c028: self.employees->exists(x | x.name <> '')
context Account inv c029: self.transactions->exists(x | x.amount <= 10)
context Branch inv c030: self.customers->exists(x | x.fullName <> '')
context CheckingAccount inv c031: self.overdraftLimit > 0
context Teller inv c032: self.counterNo.mod(8) = 0
context SavingsAccount inv c033: self.interestRate > 32
context Loan inv c034: self.principal = self.interestRate
context CheckingAccount inv c035: self.overdraftLimit >= 0
context Teller inv c036: self.counterNo.mod(2) = 0
context Loan inv c037: self.principal - self.interestRate >= 0
context Account inv c038: self.balance < 69
context Customer inv c040: self.accounts->collect(x | x.transactions)->flatten()->notEmpty()
context Loan inv c041: (if self.principal > self.interestRate then self.principal else self.interestRate endif > 45) and (self.customer.oclIsTypeOf(Customer))
context CheckingAccount inv c042: self.overdraftLimit >= 19 and self.overdraftLimit <= 31
context Account inv c043: self.transactions->size() >= 1 and self.transactions->size() <= 2
context Teller inv c044: (self.counterNo.abs() <= 2) and (self.counterNo.mod(2) = 0)
context CheckingAccount inv c045: (self.overdraftLimit < 80) and (self.overdraftLimit > 0)
context Customer inv c046: self.loans->size() = 1
context CreditCard inv c047: self.cardTransactions->size() > 0
context Account inv c048: self.transactions->size() <= 3
context Address inv c049: self.city <> null and self.line1 <> null
context Account inv c050: self.transactions->notEmpty()
context Address inv c051: self.city <> self.line1
context Address inv c052: (self.line1 <> null) = (self.country <> null)
context Branch inv c053: self.employees->notEmpty()
context Branch inv c054: self.employees->size() = 3
context Address inv c055: self.country <> null implies self.line1 <> null
context Address inv c056: self.line1 <> null and self.city <> null
context Address inv c057: (self.city <> null) = (self.line1 <> null)
context Address inv c058: self.line1 <> null implies self.country <> null
context Address inv c059: self.line1 <> null implies self.city <> null
context Customer inv c060: self.cards->forAll(x | x.limit >= 0)
context Account inv c061: (self.balance > 5) and (self.transactions->forAll(v | v.amount >= 1))
context Branch inv c062: (self.city <> '') and (self.employees->forAll(v | v.name <> ''))
context Account inv c063: (self.balance < 1000) and (self.transactions->forAll(v | v.amount >= 2))
