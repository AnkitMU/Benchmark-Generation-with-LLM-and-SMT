model EcommerceSystem

enum OrderStatus {Created, Paid, Shipped, Delivered, Cancelled}
enum PaymentStatus {Pending, Success, Failed, Refunded}

class Address
attributes
  line1 : String
  city : String
  country : String
  postalCode : String
end

class Shipment
attributes
  carrier : String
  trackingNo : String
  shippedAt : String
end

class SupportTicket
attributes
  ticketNo : String
  subject : String
  status : String
end

class ProductVariant
attributes
  variantId : String
  optionName : String
  optionValue : String
  priceDelta : Integer
end

class DiscountRule
attributes
  minOrderTotal : Integer
  percentOff : Integer
end

class Product
attributes
  sku : String
  name : String
  basePrice : Integer
end

class Category
attributes
  title : String
end

class Supplier
attributes
  name : String
  contactEmail : String
end

class Cart
attributes
  createdAt : String
end

class Coupon
attributes
  code : String
  validUntil : String
end

class CartItem
attributes
  quantity : Integer
end

class Store
attributes
  name : String
  currency : String
end

class Customer
attributes
  customerId : String
  fullName : String
  email : String
end

class Payment
attributes
  amount : Integer
  paidAt : String
  status : PaymentStatus
end

class Order
attributes
  orderNo : String
  placedAt : String
  status : OrderStatus
end

class OrderItem
attributes
  quantity : Integer
  unitPrice : Integer
end

class ReturnRequest
attributes
  reason : String
  requestedAt : String
end

class Review
attributes
  rating : Integer
  comment : String
end

class InventoryItem
attributes
  quantity : Integer
  warehouseCode : String
end

association Address_customer between
  Address[0..*] role addresses
  Customer[1] role customer
end

association Shipment_order between
  Shipment[0..1] role shipment
  Order[1] role order
end

association SupportTicket_customer between
  SupportTicket[0..*] role tickets
  Customer[1] role customer
end

association ProductVariant_product between
  ProductVariant[0..*] role variants
  Product[1] role product
end

association ProductVariant_inventory between
  ProductVariant[1] role variant
  InventoryItem[0..1] role inventory
end

association DiscountRule_coupon between
  DiscountRule[0..1] role rule
  Coupon[1] role coupon
end

association Product_store between
  Product[0..*] role products
  Store[1] role store
end

association Product_category between
  Product[0..*] role products
  Category[1] role category
end

association Product_reviews between
  Product[1] role product
  Review[0..*] role reviews
end

association Category_store between
  Category[0..*] role categories
  Store[1] role store
end

association Supplier_inventoryItems between
  Supplier[0..1] role supplier
  InventoryItem[0..*] role inventoryItems
end

association Cart_customer between
  Cart[0..1] role cart
  Customer[1] role customer
end

association Cart_items between
  Cart[1] role cart
  CartItem[0..*] role items
end

association Coupon_store between
  Coupon[0..*] role coupons
  Store[1] role store
end

association Coupon_orders between
  Coupon[0..1] role coupon
  Order[0..*] role orders
end

association CartItem_variant between
  CartItem[0..*] role cartItem_variant_src
  ProductVariant[1] role variant
end

association Customer_orders between
  Customer[1] role customer
  Order[0..*] role orders
end

association Payment_order between
  Payment[0..1] role payment
  Order[1] role order
end

association Order_items between
  Order[1] role order
  OrderItem[0..*] role items
end

association OrderItem_variant between
  OrderItem[0..*] role orderItem_variant_src
  ProductVariant[1] role variant
end

association ReturnRequest_order between
  ReturnRequest[0..*] role returnRequest_order_src
  Order[1] role order
end

association ReturnRequest_item between
  ReturnRequest[0..*] role returnRequest_item_src
  OrderItem[0..1] role item
end

association Review_customer between
  Review[0..*] role review_customer_src
  Customer[1] role customer
end

constraints
context InventoryItem inv c000: self.supplier <> null
context Category inv c001: self.store.currency <> ''
context ReturnRequest inv c002: self.item.order = self.order
context Customer inv c003: self.cart <> null
context Coupon inv c004: self.rule <> null
context ProductVariant inv c005: self.inventory <> null
context Category inv c006: self.store.name <> ''
context Cart inv c007: (self.createdAt <> '') and (self.items->forAll(v | v.quantity > 2))
context Coupon inv c008: (self.validUntil <> '') and (self.orders->forAll(v | v.placedAt <> ''))
context Product inv c009: (self.basePrice >= 5) and (self.variants->forAll(v | v.priceDelta >= 10))
context Customer inv c010: (self.email <> '') and (self.addresses->forAll(v | v.city <> ''))
context Store inv c011: self.categories->exists(x | x.title <> '')
context Supplier inv c012: self.inventoryItems->exists(x | x.quantity >= 0)
context OrderItem inv c013: (self.order.customer.customerId <> '') and (self.unitPrice < 12)
context DiscountRule inv c014: ((self.coupon.store.name <> '') and (self.coupon.oclIsTypeOf(Coupon))) and (self.percentOff >= 0)
context CartItem inv c018: (self.cart.customer.email <> '') and (self.quantity < 90)
context ReturnRequest inv c021: (self.item.order = self.order) and (self.reason <> null)
context Order inv c023: self.items->select(x | x.quantity <= 100)->size() >= 1
context Order inv c026: (self.items->one(x | x.unitPrice >= 1)) and (self.items->size() <= 1)
context Category inv c027: (self.products->collect(x | x.sku)->notEmpty()) and (self.store.oclIsTypeOf(Store))
context Order inv c029: self.items->exists(x | x.unitPrice > 1)
context InventoryItem inv c030: self.quantity >= 49 and self.quantity <= 94
context CartItem inv c031: self.quantity.mod(2) = 1
context CartItem inv c032: self.quantity.mod(7) = 0
context InventoryItem inv c033: self.quantity > 0
context Payment inv c034: self.amount >= 59 and self.amount <= 76
context DiscountRule inv c035: self.percentOff >= 0
context Payment inv c036: self.amount > 24
context Cart inv c037: self.items->size() >= 3 and self.items->size() <= 3
context OrderItem inv c038: self.quantity.mod(2) = 0
context CartItem inv c039: ((self.quantity >= 0) and (self.variant.oclIsTypeOf(ProductVariant))) and (self.quantity.mod(7) = 0)
context OrderItem inv c040: (self.quantity.abs() <= 5) and (self.order.customer.email <> '')
context Payment inv c041: self.amount > 0
context OrderItem inv c042: self.unitPrice >= 0
context Coupon inv c043: self.orders->size() <> 1
context Order inv c044: self.items->size() = 1
context Category inv c045: self.products->size() > 0
context Customer inv c047: self.addresses->size() >= 1
context Order inv c048: self.items->size() <= 1
context Store inv c049: self.categories->collect(x | x.products)->flatten()->notEmpty()
context Customer inv c050: self.addresses->size() <> 1
context Category inv c051: self.products->notEmpty()
context Product inv c052: (self.reviews->collect(x | x.rating)->sum() >= 8) and (self.basePrice <> null)
context Customer inv c053: self.orders->size() = 1
context Category inv c054: self.products->size() >= 3
context Cart inv c055: self.items->size() > 0
context Cart inv c057: (self.items->size() <> 1) and (self.items->size() > 0)
context Category inv c058: (self.products->notEmpty()) and (self.products->select(x | x.basePrice < 1000)->size() >= 1)
context Cart inv c059: ((self.items->size() >= 2) and (self.customer.oclIsTypeOf(Customer))) and (self.items->size() >= 1)
context Store inv c062: self.products->exists(x | x.basePrice > 2)
context Order inv c063: self.items->forAll(x | x.unitPrice >= 5)
context CartItem inv c064: (self.quantity > 71) and (self.quantity > 0)
context Customer inv c065: (self.customerId <> '') and (self.orders->forAll(v | v.orderNo <> ''))
context Coupon inv c066: (self.code <> '') and (self.orders->forAll(v | v.placedAt <> ''))
context Customer inv c067: (self.fullName <> '') and (self.orders->forAll(v | v.orderNo <> ''))
context Customer inv c068: (self.email <> '') and (self.tickets->forAll(v | v.status <> ''))
context Customer inv c069: (self.fullName <> '') and (self.addresses->forAll(v | v.postalCode <> ''))
context Customer inv c070: (self.customerId <> '') and (self.tickets->forAll(v | v.status <> ''))
context Product inv c071: (self.variants->size() = 1) and (self.sku <> null)
