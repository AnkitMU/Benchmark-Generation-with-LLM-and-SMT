model FlightBooking

enum BookingStatus {Pending, Confirmed, Cancelled}
enum SeatClass {Economy, PremiumEconomy, Business, First}

class Airline
attributes
  code : String
  name : String
end

class BoardingPass
attributes
  barcode : String
  gate : String
  boardingTime : String
end

class Seat
attributes
  seatNo : String
  seatClass : SeatClass
end

class Passenger
attributes
  fullName : String
  passportNo : String
  email : String
end

class Booking
attributes
  bookingRef : String
  status : BookingStatus
  createdAt : String
end

class Ticket
attributes
  ticketNo : String
  issuedAt : String
end

class Aircraft
attributes
  registrationNo : String
  model_ : String
end

class Baggage
attributes
  tagNo : String
  weightKg : Integer
end

class Airport
attributes
  iataCode : String
  name : String
  city : String
end

class Flight
attributes
  flightNo : String
  departureTime : String
  arrivalTime : String
end

class CheckIn
attributes
  checkInTime : String
  isOnline : Boolean
end

class Payment
attributes
  amount : Integer
  method : String
  paidAt : String
end

association Airline_flights between
  Airline[1] role airline
  Flight[0..*] role flights
end

association Airline_aircrafts between
  Airline[1] role airline
  Aircraft[0..*] role aircrafts
end

association BoardingPass_checkIn between
  BoardingPass[0..1] role boardingPass
  CheckIn[1] role checkIn
end

association BoardingPass_seat between
  BoardingPass[0..*] role boardingPass_seat_src
  Seat[0..1] role seat
end

association Seat_aircraft between
  Seat[0..*] role seats
  Aircraft[1] role aircraft
end

association Passenger_bookings between
  Passenger[1] role passenger
  Booking[0..*] role bookings
end

association Booking_flight between
  Booking[0..*] role bookings
  Flight[1] role flight
end

association Booking_ticket between
  Booking[1] role booking
  Ticket[0..1] role ticket
end

association Booking_payment between
  Booking[1] role booking
  Payment[0..1] role payment
end

association Booking_baggages between
  Booking[1] role booking
  Baggage[0..*] role baggages
end

association Booking_checkIn between
  Booking[1] role booking
  CheckIn[0..1] role checkIn
end

association Airport_departingFlights between
  Airport[1] role departureAirport
  Flight[0..*] role departingFlights
end

association Airport_arrivingFlights between
  Airport[1] role arrivalAirport
  Flight[0..*] role arrivingFlights
end

association Flight_aircraft between
  Flight[0..*] role flight_aircraft_src
  Aircraft[1] role aircraft
end

constraints
context Flight inv c000: (self.flightNo <> '') and (self.bookings->forAll(v | v.createdAt <> ''))
context Booking inv c001: (self.bookingRef <> '') and (self.baggages->forAll(v | v.weightKg < 50))
context Aircraft inv c002: (self.model_ <> '') and (self.seats->forAll(v | v.seatNo <> ''))
context Flight inv c003: (self.departureTime <> '') and (self.bookings->forAll(v | v.bookingRef <> ''))
context BoardingPass inv c004: self.checkIn.isOnline
context CheckIn inv c005: self.isOnline implies self.boardingPass <> null
context Booking inv c006: self.ticket <> null
context Aircraft inv c007: self.airline.code <> ''
context Flight inv c008: self.aircraft.airline = self.airline
context Aircraft inv c009: self.airline.name <> ''
context CheckIn inv c010: self.boardingPass <> null
context Airline inv c011: self.flights->exists(x | x.departureTime <> '')
context Airport inv c012: self.departingFlights->exists(x | x.arrivalTime <> '')
context Booking inv c013: self.baggages->exists(x | x.weightKg <= 50)
context Aircraft inv c014: self.seats->forAll(x | x.seatNo <> '')
context Payment inv c015: (self.booking.flight.departureTime <> '') and (self.amount.abs() <= 6)
context Ticket inv c016: (self.booking.flight.departureTime <> '') and (self.ticketNo <> null)
context Baggage inv c017: (self.booking.flight.flightNo <> '') and (self.tagNo <> null)
context BoardingPass inv c018: ((self.seat <> null) and (self.seat.oclIsTypeOf(Seat))) and (self.checkIn.booking.createdAt <> '')
context Aircraft inv c020: (self.airline.code <> '') and (self.seats->size() > 0)
context Baggage inv c021: (self.booking.flight.departureTime <> '') and (self.weightKg.abs() <= 4)
context BoardingPass inv c022: (self.seat <> null) and (self.gate <> null)
context Baggage inv c023: self.weightKg >= 4 and self.weightKg <= 56
context Baggage inv c024: self.weightKg < 41
context Baggage inv c025: self.weightKg >= 0
context Payment inv c028: self.amount >= 0
context Payment inv c029: self.amount.abs() <= 8
context Payment inv c030: self.amount < 63
context Aircraft inv c031: (self.seats->size() <= 2)
context Baggage inv c032: (self.weightKg >= 0) and (self.weightKg <> null)
context Payment inv c033: self.amount < 37
context Aircraft inv c034: self.seats->size() >= 1 and self.seats->size() <= 3
context Aircraft inv c035: self.seats->size() >= 2 and self.seats->size() <= 2
context Airline inv c036: self.flights->size() >= 1 and self.flights->size() <= 1
context Baggage inv c037: (self.weightKg >= 0) and (self.tagNo <> null)
context Airline inv c038: self.aircrafts->size() >= 3 and self.aircrafts->size() <= 3
context Booking inv c040: self.baggages->select(x | x.weightKg < 100)->size() >= 1
context Airport inv c043: self.arrivingFlights->exists(x | x.arrivalTime <> '')
context Aircraft inv c044: self.seats->exists(x | x.seatNo <> '')
context Booking inv c046: self.baggages->size() >= 1
context Airport inv c047: self.departingFlights->size() <= 2
context Airline inv c048: self.aircrafts->size() > 0
context Aircraft inv c049: self.seats->size() >= 2
context Flight inv c050: self.departureTime <> self.arrivalTime
context Aircraft inv c051: self.seats->size() = 2
context Airline inv c052: self.aircrafts->notEmpty()
context Aircraft inv c053: self.seats->notEmpty()
context Flight inv c054: (self.departureTime <> null) = (self.arrivalTime <> null)
context Aircraft inv c055: self.seats->size() > 0
context Flight inv c056: self.arrivalTime <> null and self.departureTime <> null
context Flight inv c057: self.departureTime <> null and self.arrivalTime <> null
context Flight inv c059: (self.arrivalTime <> null) = (self.departureTime <> null)
context Airline inv c060: (self.flights->size() <= 2) and (self.flights->collect(x | x.flightNo)->notEmpty())
context Aircraft inv c061: (self.seats->size() <= 3) and (self.airline.code <> '')
context Booking inv c062: self.payment <> null
context Booking inv c063: self.baggages->forAll(x | x.weightKg > 0)
context Airport inv c064: self.departingFlights->collect(x | x.bookings)->flatten()->notEmpty()
