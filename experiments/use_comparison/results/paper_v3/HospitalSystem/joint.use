model HospitalSystem

enum Gender {Male, Female, Other}
enum AppointmentStatus {Scheduled, Completed, Cancelled, NoShow}

class Prescription
attributes
  prescriptionNo : String
  issuedAt : String
end

class LabResult
attributes
  value : String
  unit : String
  reportedAt : String
end

class Procedure
attributes
  name : String
  performedAt : String
end

class MedicalRecord
attributes
  recordNo : String
  createdAt : String
end

class LabTest
attributes
  testName : String
  orderedAt : String
end

class Admission
attributes
  admissionId : String
  admitDate : String
end

class Room
attributes
  roomNo : String
  type : String
end

class Bed
attributes
  bedNo : String
  isOccupied : Boolean
end

class Appointment
attributes
  appointmentId : String
  dateTime : String
  status : AppointmentStatus
end

class Diagnosis
attributes
  code : String
  description : String
  diagnosedAt : String
end

class InsurancePolicy
attributes
  policyNo : String
  provider : String
  validUntil : String
end

class Medication
attributes
  name : String
  dose : String
  frequency : String
end

class Person
attributes
  fullName : String
  dob : String
  gender : Gender
  phone : String
end

class Discharge
attributes
  dischargeDate : String
  summary : String
end

class Invoice
attributes
  invoiceNo : String
  totalAmount : Integer
  issuedAt : String
end

class Hospital
attributes
  name : String
  address : String
end

class Patient
attributes
  patientId : String
  isInsured : Boolean
end

class Payment
attributes
  amount : Integer
  paidAt : String
  method : String
end

class Ward
attributes
  name : String
  floor : Integer
end

class Department
attributes
  name : String
  phone : String
end

class Doctor
attributes
  doctorId : String
  specialty : String
end

class Nurse
attributes
  nurseId : String
  shift : String
end

association Prescription_record between
  Prescription[0..*] role prescriptions
  MedicalRecord[1] role record
end

association Prescription_medications between
  Prescription[1] role prescription
  Medication[0..*] role medications
end

association LabResult_test between
  LabResult[0..1] role result
  LabTest[1] role test
end

association Procedure_record between
  Procedure[0..*] role procedures
  MedicalRecord[1] role record
end

association Procedure_doctor between
  Procedure[0..*] role procedure_doctor_src
  Doctor[0..1] role doctor
end

association MedicalRecord_patient between
  MedicalRecord[0..*] role records
  Patient[1] role patient
end

association MedicalRecord_diagnoses between
  MedicalRecord[1] role record
  Diagnosis[0..*] role diagnoses
end

association MedicalRecord_labTests between
  MedicalRecord[1] role record
  LabTest[0..*] role labTests
end

association Admission_patient between
  Admission[0..*] role admissions
  Patient[1] role patient
end

association Admission_bed between
  Admission[0..*] role admission_bed_src
  Bed[0..1] role bed
end

association Admission_discharge between
  Admission[1] role admission
  Discharge[0..1] role discharge
end

association Room_ward between
  Room[0..*] role rooms
  Ward[1] role ward
end

association Room_beds between
  Room[1] role room
  Bed[0..*] role beds
end

association Appointment_patient between
  Appointment[0..*] role appointments
  Patient[1] role patient
end

association Appointment_doctor between
  Appointment[0..*] role appointments
  Doctor[1] role doctor
end

association InsurancePolicy_patient between
  InsurancePolicy[0..1] role insurance
  Patient[1] role patient
end

association Invoice_patient between
  Invoice[0..*] role invoice_patient_src
  Patient[1] role patient
end

association Invoice_payment between
  Invoice[1] role invoice
  Payment[0..1] role payment
end

association Hospital_departments between
  Hospital[1] role hospital
  Department[0..*] role departments
end

association Hospital_wards between
  Hospital[1] role hospital
  Ward[0..*] role wards
end

association Department_doctors between
  Department[1] role department
  Doctor[0..*] role doctors
end

association Department_nurses between
  Department[1] role department
  Nurse[0..*] role nurses
end

constraints
context Department inv c000: self.hospital.address <> ''
context Patient inv c001: self.isInsured implies self.insurance <> null
context Ward inv c002: self.hospital.name <> ''
context Invoice inv c003: self.payment <> null
context Procedure inv c004: self.doctor <> null
context Admission inv c005: self.bed.isOccupied
context Prescription inv c006: (self.issuedAt <> '') and (self.medications->forAll(v | v.name <> ''))
context Department inv c007: (self.phone <> '') and (self.doctors->forAll(v | v.doctorId <> ''))
context Ward inv c008: (self.floor <= 50) and (self.rooms->forAll(v | v.roomNo <> ''))
context Hospital inv c009: self.departments->exists(x | x.name <> '')
context Doctor inv c010: self.appointments->exists(x | x.appointmentId <> '')
context Department inv c011: self.doctors->exists(x | x.specialty <> '')
context MedicalRecord inv c012: self.procedures->exists(x | x.performedAt <> '')
context Department inv c013: self.doctors->forAll(x | x.specialty <> '')
context Hospital inv c017: self.wards->select(x | x.floor >= 2)->size() >= 1
context Department inv c019: (self.nurses->collect(x | x.nurseId)->notEmpty()) and (self.doctors->notEmpty())
context Doctor inv c020: self.appointments->size() >= 1 and self.appointments->size() <= 2
context Ward inv c021: self.floor > 0
context Ward inv c022: self.floor < 72
context Invoice inv c023: (self.totalAmount >= 0) and (self.totalAmount.abs() <= 8)
context Invoice inv c024: self.totalAmount >= 0
context Ward inv c025: self.floor < 11
context Ward inv c026: self.floor >= 0
context Invoice inv c027: (self.totalAmount >= 0) and (self.totalAmount > 0)
context Ward inv c028: self.floor < 95
context Ward inv c029: self.floor < 29
context Ward inv c030: (self.floor > 0) and (self.rooms->size() = 1)
context Department inv c037: self.nurses->exists(x | x.nurseId <> '')
context Hospital inv c038: self.wards->forAll(x | x.floor < 50)
context MedicalRecord inv c039: self.prescriptions->exists(x | x.issuedAt <> '')
context Department inv c040: self.doctors->size() = 2
context Hospital inv c041: self.wards->size() = 1
context MedicalRecord inv c042: self.procedures->size() > 0
context MedicalRecord inv c043: self.labTests->size() >= 2
context Doctor inv c044: self.appointments->size() <= 3
context MedicalRecord inv c045: self.prescriptions->size() <> 1
context MedicalRecord inv c046: self.procedures->notEmpty()
context Patient inv c047: self.records->collect(x | x.prescriptions)->size() >= 3
context Ward inv c048: self.rooms->collect(x | x.beds)->size() >= 1
context Ward inv c053: (self.rooms->notEmpty()) and (self.floor.abs() <= 8)
context MedicalRecord inv c054: self.prescriptions->collect(x | x.medications)->size() >= 2
context Admission inv c055: self.bed <> null
context Hospital inv c056: self.wards->exists(x | x.floor <= 10)
context Patient inv c058: (self.admissions->size() <= 3) and (self.admissions->size() >= 1)
context Department inv c059: (self.name <> '') and (self.nurses->forAll(v | v.nurseId <> ''))
context Ward inv c060: (self.floor >= 0) and (self.rooms->forAll(v | v.roomNo <> ''))
context Department inv c061: (self.name <> '') and (self.doctors->forAll(v | v.specialty <> ''))
