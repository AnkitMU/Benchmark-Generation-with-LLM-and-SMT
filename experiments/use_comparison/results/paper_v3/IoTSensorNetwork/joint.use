model IoTSensorNetwork

enum DeviceStatus {Online, Offline, Fault}
enum ProtocolType {MQTT, CoAP, HTTP}
enum Severity {Low, Medium, High, Critical}

class EventLog
attributes
  logId : String
  time : String
  message : String
end

class Battery
attributes
  healthPct : Integer
end

class TelemetryRecord
attributes
  timestamp : String
  payload : String
end

class OTAUpdate
attributes
  updateId : String
  version : String
  scheduledAt : String
  applied : Boolean
end

class APIKey
attributes
  keyId : String
  value : String
  createdAt : String
  isActive : Boolean
end

class ConnectivityModule
attributes
  macAddress : String
  protocol : ProtocolType
end

class CommunicationLink
attributes
  linkId : String
  bandwidthKbps : Integer
  isSecure : Boolean
end

class Device
attributes
  deviceId : String
  name : String
  status : DeviceStatus
end

class AccessPolicy
attributes
  policyId : String
  description : String
  rulesJson : String
end

class Role
attributes
  roleName : String
end

class Metric
attributes
  name : String
  unit : String
  lastValue : Integer
end

class Gateway
attributes
  ipAddress : String
  isPrimary : Boolean
end

class PowerSource
attributes
  type : String
  capacity : Integer
end

class MaintenanceTicket
attributes
  ticketId : String
  openedAt : String
  status : String
end

class SolarPanel
attributes
  wattPeak : Integer
end

class ActuatorNode
attributes
  actuatorType : String
  maxLoad : Integer
end

class SensorNode
attributes
  sensorType : String
  sampleRateHz : Integer
end

class Firmware
attributes
  version : String
  checksum : String
end

class Location
attributes
  latitude : Integer
  longitude : Integer
  site : String
end

class ConfigurationProfile
attributes
  profileId : String
  updatedAt : String
end

class AlertRule
attributes
  ruleId : String
  condition : String
  severity : Severity
end

class Network
attributes
  networkId : String
  name : String
end

class IoTPlatform
attributes
  name : String
  version : String
end

class EdgeNode
attributes
  cpuCores : Integer
  memoryMB : Integer
end

class DataStream
attributes
  streamId : String
  topic : String
end

class Alert
attributes
  alertId : String
  createdAt : String
  message : String
  acknowledged : Boolean
end

class Cluster
attributes
  clusterId : String
  name : String
end

class User
attributes
  userId : String
  name : String
  email : String
end

association EventLog_device between
  EventLog[0..*] role eventLogs
  Device[1] role device
end

association TelemetryRecord_stream between
  TelemetryRecord[0..*] role records
  DataStream[1] role stream
end

association OTAUpdate_targetDevice between
  OTAUpdate[0..*] role otaUpdates
  Device[1] role targetDevice
end

association OTAUpdate_tickets between
  OTAUpdate[0..1] role otaUpdate
  MaintenanceTicket[0..*] role tickets
end

association APIKey_user between
  APIKey[0..*] role apiKeys
  User[1] role user
end

association ConnectivityModule_device between
  ConnectivityModule[0..1] role connectivity
  Device[1] role device
end

association ConnectivityModule_links between
  ConnectivityModule[1] role module
  CommunicationLink[0..*] role links
end

association CommunicationLink_network between
  CommunicationLink[0..*] role links
  Network[1] role network
end

association CommunicationLink_stream between
  CommunicationLink[0..1] role link
  DataStream[0..1] role stream
end

association Device_firmware between
  Device[0..*] role devices
  Firmware[0..1] role firmware
end

association Device_config between
  Device[1] role device
  ConfigurationProfile[0..1] role config
end

association Device_location between
  Device[1] role device
  Location[0..1] role location
end

association Device_powerSource between
  Device[1] role device
  PowerSource[0..1] role powerSource
end

association Device_dataStreams between
  Device[1] role device
  DataStream[0..*] role dataStreams
end

association Device_tickets between
  Device[1] role device
  MaintenanceTicket[0..*] role tickets
end

association AccessPolicy_platform between
  AccessPolicy[0..*] role accessPolicies
  IoTPlatform[1] role platform
end

association AccessPolicy_roles between
  AccessPolicy[0..*] role policies
  Role[0..*] role roles
end

association Role_platform between
  Role[0..*] role roles
  IoTPlatform[1] role platform
end

association Role_users between
  Role[0..*] role roles
  User[0..*] role users
end

association Metric_sensor between
  Metric[0..*] role metrics
  SensorNode[1] role sensor
end

association Gateway_cluster between
  Gateway[0..*] role gateways
  Cluster[1] role cluster
end

association Gateway_connectedEdges between
  Gateway[0..1] role gateway
  EdgeNode[0..*] role connectedEdges
end

association MaintenanceTicket_assignedTo between
  MaintenanceTicket[0..*] role maintenanceTicket_assignedTo_src
  User[0..1] role assignedTo
end

association AlertRule_stream between
  AlertRule[0..*] role alertRules
  DataStream[1] role stream
end

association AlertRule_alerts between
  AlertRule[1] role rule
  Alert[0..*] role alerts
end

association Network_platform between
  Network[0..*] role networks
  IoTPlatform[1] role platform
end

association Network_clusters between
  Network[1] role network
  Cluster[0..*] role clusters
end

association IoTPlatform_users between
  IoTPlatform[1] role platform
  User[0..*] role users
end

association EdgeNode_cluster between
  EdgeNode[0..*] role edgeNodes
  Cluster[1] role cluster
end

association Alert_assignedTo between
  Alert[0..*] role alerts
  User[0..1] role assignedTo
end

constraints
context AccessPolicy inv c000: (self.policyId <> '') and (self.roles->forAll(v | v.roleName <> ''))
context Device inv c001: (self.name <> '') and (self.dataStreams->forAll(v | v.streamId <> ''))
context Network inv c002: (self.networkId <> '') and (self.clusters->forAll(v | v.clusterId <> ''))
context Alert inv c003: self.acknowledged implies self.assignedTo <> null
context Metric inv c004: self.sensor.sampleRateHz < 50
context User inv c005: self.platform.version <> ''
context Role inv c006: self.platform.name <> ''
context MaintenanceTicket inv c007: self.otaUpdate.applied
context EdgeNode inv c008: self.gateway.isPrimary
context CommunicationLink inv c009: self.stream <> null
context MaintenanceTicket inv c010: self.otaUpdate.targetDevice = self.device
context Alert inv c011: self.assignedTo <> null
context EdgeNode inv c012: self.gateway.cluster = self.cluster
context Firmware inv c013: self.devices->forAll(x | x.deviceId <> '')
context ConnectivityModule inv c014: (self.macAddress <> '') and (self.links->forAll(v | v.bandwidthKbps > 10))
context OTAUpdate inv c015: self.tickets->forAll(x | x.status <> '')
context SensorNode inv c016: self.metrics->exists(x | x.lastValue >= 5)
context IoTPlatform inv c017: self.accessPolicies->exists(x | x.policyId <> '')
context PowerSource inv c018: (self.device.firmware.checksum <> '') and (self.capacity > 0)
context Location inv c022: (self.device.firmware.checksum <> '') and (self.longitude >= 7 and self.longitude <= 41)
context CommunicationLink inv c023: self.isSecure implies self.stream <> null
context Network inv c024: self.links->select(x | x.bandwidthKbps >= 2)->size() >= 1
context AccessPolicy inv c025: (self.roles->collect(x | x.roleName)->notEmpty()) and (self.roles->size() >= 1)
context SensorNode inv c027: self.metrics->select(x | x.lastValue <= 50)->size() >= 1
context Network inv c030: self.links->forAll(x | x.bandwidthKbps >= 10)
context AlertRule inv c031: self.alerts->exists(x | x.acknowledged <> false)
context Cluster inv c032: self.edgeNodes->forAll(x | x.memoryMB <= 10)
context Cluster inv c033: self.edgeNodes->exists(x | x.cpuCores <= 1000)
context Gateway inv c034: self.connectedEdges->forAll(x | x.memoryMB < 100)
context SolarPanel inv c035: self.wattPeak >= 26 and self.wattPeak <= 51
context ActuatorNode inv c036: self.maxLoad >= 13 and self.maxLoad <= 54
context EdgeNode inv c037: self.memoryMB.mod(2) = 0
context SensorNode inv c038: self.sampleRateHz.mod(2) = 1
context SensorNode inv c039: self.sampleRateHz.mod(3) = 0
context EdgeNode inv c040: self.memoryMB > 0
context ActuatorNode inv c041: self.maxLoad >= 7 and self.maxLoad <= 50
context ActuatorNode inv c043: (self.maxLoad < 27) and (self.maxLoad >= 0)
context CommunicationLink inv c045: self.bandwidthKbps.mod(2) = 0
context EdgeNode inv c046: (self.cpuCores.mod(2) = 1) and (self.cpuCores.abs() <= 9)
context EdgeNode inv c048: (self.cpuCores.abs() <= 2) and (self.memoryMB.mod(2) = 0)
context Battery inv c049: self.healthPct > 0
context Location inv c050: self.latitude >= 0
context CommunicationLink inv c051: self.bandwidthKbps >= 42 and self.bandwidthKbps <= 64
context DataStream inv c052: self.alertRules->size() = 1
context DataStream inv c053: self.records->size() <= 3
context AlertRule inv c054: self.alerts->size() > 0
context AlertRule inv c055: self.alerts->size() <= 1
context AccessPolicy inv c056: self.roles->notEmpty()
context AlertRule inv c057: self.alerts->notEmpty()
context AccessPolicy inv c058: self.roles->size() > 0
context ConnectivityModule inv c059: self.links->size() <= 1
context Cluster inv c060: (self.gateways->collect(x | x.connectedEdges)->size() >= 3) and (self.gateways->size() >= 1)
context DataStream inv c061: self.alertRules->collect(x | x.alerts)->flatten()->notEmpty()
context Alert inv c063: (self.acknowledged = true) and (self.acknowledged implies self.assignedTo <> null)
context Alert inv c064: ((self.acknowledged) and (self.assignedTo <> null)) and (self.acknowledged = true)
context Device inv c067: (self.deviceId <> '') and (self.tickets->forAll(v | v.ticketId <> ''))
context DataStream inv c068: (self.topic <> '') and (self.records->forAll(v | v.timestamp <> ''))
context Cluster inv c069: (self.gateways->size() > 0) and (self.gateways->collect(x | x.ipAddress)->notEmpty())
context SensorNode inv c070: (self.metrics->size() >= 1) and (self.metrics->size() <= 1)
