model LibrarySystem

enum CopyStatus {Available, Loaned, Lost}

class Staff
attributes
  staffId : String
  name : String
  email : String
end

class Publisher
attributes
  name : String
end

class Library
attributes
  name : String
  maxLoanDays : Integer
end

class Librarian
attributes
  level : String
end

class Branch
attributes
  name : String
  code : String
  phone : String
end

class Copy
attributes
  barcode : String
  status : CopyStatus
end

class Book
attributes
  isbn : String
  title : String
  publishYear : Integer
  pages : Integer
end

class Author
attributes
  name : String
end

class Category
attributes
  name : String
end

class Loan
attributes
  startDate : String
  dueDate : String
  returnDate : String
end

class Reservation
attributes
  requestDate : String
  expiryDate : String
end

class Address
attributes
  line1 : String
  city : String
  country : String
end

class Member
attributes
  memberId : String
  name : String
  email : String
  joinDate : String
end

class Payment
attributes
  amount : Integer
  timestamp : String
  isProcessed : Boolean
end

class Fine
attributes
  amount : Integer
  reason : String
end

association Staff_branch between
  Staff[0..*] role staff
  Branch[1] role branch
end

association Publisher_books between
  Publisher[0..1] role publisher
  Book[0..*] role books
end

association Library_branches between
  Library[1] role library
  Branch[0..*] role branches
end

association Library_members between
  Library[1] role library
  Member[0..*] role members
end

association Library_books between
  Library[1] role library
  Book[0..*] role books
end

association Librarian_managedBranch between
  Librarian[0..1] role manager
  Branch[0..1] role managedBranch
end

association Branch_address between
  Branch[0..1] role branch
  Address[0..1] role address
end

association Branch_copies between
  Branch[1] role branch
  Copy[0..*] role copies
end

association Branch_loans between
  Branch[1] role branch
  Loan[0..*] role loans
end

association Branch_reservations between
  Branch[1] role branch
  Reservation[0..*] role reservations
end

association Copy_book between
  Copy[0..*] role copies
  Book[1] role book
end

association Copy_loans between
  Copy[1] role copy
  Loan[0..*] role loans
end

association Copy_reservations between
  Copy[0..1] role copy
  Reservation[0..*] role reservations
end

association Book_authors between
  Book[0..*] role books
  Author[0..*] role authors
end

association Book_category between
  Book[0..*] role books
  Category[0..1] role category
end

association Book_reservations between
  Book[1] role book
  Reservation[0..*] role reservations
end

association Loan_member between
  Loan[0..*] role loans
  Member[1] role member
end

association Loan_fine between
  Loan[1] role loan
  Fine[0..1] role fine
end

association Loan_payment between
  Loan[0..1] role loan
  Payment[0..1] role payment
end

association Reservation_member between
  Reservation[0..*] role reservations
  Member[1] role member
end

association Address_member between
  Address[0..1] role homeAddress
  Member[0..1] role member
end

association Member_fines between
  Member[1] role member
  Fine[0..*] role fines
end

association Member_payments between
  Member[1] role member
  Payment[0..*] role payments
end

association Payment_fine between
  Payment[0..*] role payments
  Fine[0..1] role fine
end

constraints
context Book inv c000: self.publisher <> null
context Payment inv c001: self.isProcessed implies self.loan <> null
context Loan inv c002: self.copy.branch = self.branch
context Address inv c003: self.branch <> null
context Reservation inv c004: self.copy.book = self.book
context Fine inv c005: self.loan.member = self.member
context Branch inv c006: self.manager <> null
context Copy inv c007: self.reservations->forAll(x | x.requestDate <> '')
context Library inv c008: self.members->forAll(x | x.memberId <> '')
context Publisher inv c009: self.books->exists(x | x.pages < 1000)
context Category inv c010: self.books->forAll(x | x.pages >= 2)
context Copy inv c011: (self.barcode <> '') and (self.loans->forAll(v | v.dueDate <> ''))
context Fine inv c012: (self.amount < 1000) and (self.payments->forAll(v | v.amount < 50))
context Branch inv c013: (self.code <> '') and (self.copies->forAll(v | v.barcode <> ''))
context Branch inv c014: (self.code <> '') and (self.reservations->forAll(v | v.expiryDate <> ''))
context Book inv c015: (self.publishYear <= 1000) and (self.reservations->forAll(v | v.expiryDate <> ''))
context Book inv c016: (self.pages > 2) and (self.authors->forAll(v | v.name <> ''))
context Payment inv c019: self.isProcessed implies self.fine <> null
context Address inv c022: (self.member <> null) and (self.branch <> null)
context Member inv c025: self.payments->select(x | x.amount > 5)->size() >= 1
context Fine inv c027: self.payments->size() >= 1 and self.payments->size() <= 1
context Library inv c028: (self.maxLoanDays.mod(2) = 0) and (self.books->size() > 1)
context Library inv c029: self.maxLoanDays.mod(6) = 0
context Fine inv c030: self.amount >= 0
context Book inv c032: ((self.pages < 17) and (self.authors->notEmpty())) and (self.copies->size() > 0)
context Book inv c033: (self.publishYear < 42) and (self.reservations->one(x | x.requestDate <> ''))
context Book inv c035: self.pages.mod(2) = 0
context Book inv c036: (self.publishYear.mod(2) = 0) and (self.authors->collect(x | x.books)->size() >= 2)
context Fine inv c037: self.amount > 0
context Author inv c038: self.books->size() >= 3 and self.books->size() <= 3
context Payment inv c039: ((self.amount > 31) and (self.isProcessed)) and (self.fine.oclIsTypeOf(Fine))
context Member inv c040: self.payments->forAll(x | x.amount > 5)
context Author inv c041: self.books->size() <> 1
context Branch inv c042: self.reservations->size() = 3
context Book inv c043: self.authors->size() > 0
context Loan inv c044: self.returnDate <> self.startDate
context Book inv c045: self.copies->size() >= 2
context Book inv c046: self.reservations->size() <= 3
context Author inv c047: self.books->size() <= 3
context Loan inv c048: (self.dueDate <> null) = (self.returnDate <> null)
context Author inv c049: self.books->size() >= 2
context Reservation inv c050: self.requestDate <> self.expiryDate
context Reservation inv c051: self.requestDate <> null implies self.expiryDate <> null
context Branch inv c052: self.reservations->size() > 0
context Loan inv c053: self.dueDate <> null and self.startDate <> null
context Reservation inv c054: self.expiryDate <> null implies self.requestDate <> null
context Loan inv c055: self.startDate <> null implies self.dueDate <> null
context Loan inv c056: (self.returnDate <> null) = (self.startDate <> null)
context Loan inv c057: self.startDate <> null and self.dueDate <> null and self.returnDate <> null
context Reservation inv c058: self.expiryDate <> null and self.requestDate <> null
context Book inv c059: (self.pages < 100) and (self.copies->forAll(v | v.barcode <> ''))
context Fine inv c060: (self.amount > 0) and (self.payments->forAll(v | v.amount >= 10))
context Library inv c062: self.branches->collect(x | x.copies)->flatten()->notEmpty()
context Book inv c063: self.authors->collect(x | x.books)->flatten()->notEmpty()
context Library inv c064: (self.members->collect(x | x.reservations)->size() >= 3) and (self.members->size() <= 1)
context Branch inv c065: (self.phone <> '') and (self.reservations->forAll(v | v.expiryDate <> ''))
