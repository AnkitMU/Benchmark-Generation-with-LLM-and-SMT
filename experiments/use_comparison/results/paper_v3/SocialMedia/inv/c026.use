model SocialMedia

enum ReactionType {Like, Love, Haha, Wow, Sad, Angry}
enum NotificationType {FriendRequest, Comment, Reaction, Follow, Message, Tag}

class Group
attributes
  name : String
  createdAt : String
end

class Message
attributes
  body : String
  sentAt : String
  isRead : Boolean
end

class Conversation
attributes
  createdAt : String
end

class Follow
attributes
  followedAt : String
end

class Membership
attributes
  role_ : String
  joinedAt : String
end

class User
attributes
  username : String
  email : String
  createdAt : String
end

class Reaction
attributes
  type : ReactionType
  createdAt : String
end

class Notification
attributes
  type : NotificationType
  message : String
  createdAt : String
  isSeen : Boolean
end

class Media
attributes
  url : String
  mediaType : String
end

class Tag
attributes
  label : String
end

class Profile
attributes
  fullName : String
  bio : String
  birthDate : String
end

class FriendRequest
attributes
  createdAt : String
  isAccepted : Boolean
end

class Comment
attributes
  text : String
  createdAt : String
end

class Post
attributes
  content : String
  createdAt : String
  isPublic : Boolean
end

association Group_memberships between
  Group[1] role group
  Membership[0..*] role memberships
end

association Message_conversation between
  Message[0..*] role messages
  Conversation[1] role conversation
end

association Message_sender between
  Message[0..*] role message_sender_src
  User[1] role sender
end

association Conversation_participants between
  Conversation[0..*] role conversation_participants_src
  User[0..*] role participants
end

association Follow_follower between
  Follow[0..*] role follow_follower_src
  User[1] role follower
end

association Follow_followee between
  Follow[0..*] role follow_followee_src
  User[1] role followee
end

association Membership_user between
  Membership[0..*] role membership_user_src
  User[1] role user
end

association User_profile between
  User[1] role user
  Profile[0..1] role profile
end

association User_posts between
  User[1] role author
  Post[0..*] role posts
end

association User_notifications between
  User[1] role recipient
  Notification[0..*] role notifications
end

association Reaction_post between
  Reaction[0..*] role reactions
  Post[1] role post_
end

association Reaction_user between
  Reaction[0..*] role reaction_user_src
  User[1] role user
end

association Media_post between
  Media[0..*] role media
  Post[1] role post_
end

association Tag_posts between
  Tag[0..*] role tag_posts_src
  Post[0..*] role posts
end

association FriendRequest_fromUser between
  FriendRequest[0..*] role friendRequest_fromUser_src
  User[1] role fromUser
end

association FriendRequest_toUser between
  FriendRequest[0..*] role friendRequest_toUser_src
  User[1] role toUser
end

association Comment_post between
  Comment[0..*] role comments
  Post[1] role post_
end

association Comment_author between
  Comment[0..*] role comment_author_src
  User[1] role author
end

constraints
context Follow inv c026: (self.follower.profile.birthDate <> '') and (self.followedAt.indexOf('test') >= 0)
