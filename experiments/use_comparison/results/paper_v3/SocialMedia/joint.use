model SocialMedia

enum ReactionType {Like, Love, Haha, Wow, Sad, Angry}
enum NotificationType {FriendRequest, Comment, Reaction, Follow, Message, Tag}

class Group
attributes
  name : String
  createdAt : String
end

class Message
attributes
  body : String
  sentAt : String
  isRead : Boolean
end

class Conversation
attributes
  createdAt : String
end

class Follow
attributes
  followedAt : String
end

class Membership
attributes
  role_ : String
  joinedAt : String
end

class User
attributes
  username : String
  email : String
  createdAt : String
end

class Reaction
attributes
  type : ReactionType
  createdAt : String
end

class Notification
attributes
  type : NotificationType
  message : String
  createdAt : String
  isSeen : Boolean
end

class Media
attributes
  url : String
  mediaType : String
end

class Tag
attributes
  label : String
end

class Profile
attributes
  fullName : String
  bio : String
  birthDate : String
end

class FriendRequest
attributes
  createdAt : String
  isAccepted : Boolean
end

class Comment
attributes
  text : String
  createdAt : String
end

class Post
attributes
  content : String
  createdAt : String
  isPublic : Boolean
end

association Group_memberships between
  Group[1] role group
  Membership[0..*] role memberships
end

association Message_conversation between
  Message[0..*] role messages
  Conversation[1] role conversation
end

association Message_sender between
  Message[0..*] role message_sender_src
  User[1] role sender
end

association Conversation_participants between
  Conversation[0..*] role conversation_participants_src
  User[0..*] role participants
end

association Follow_follower between
  Follow[0..*] role follow_follower_src
  User[1] role follower
end

association Follow_followee between
  Follow[0..*] role follow_followee_src
  User[1] role followee
end

association Membership_user between
  Membership[0..*] role membership_user_src
  User[1] role user
end

association User_profile between
  User[1] role user
  Profile[0..1] role profile
end

association User_posts between
  User[1] role author
  Post[0..*] role posts
end

association User_notifications between
  User[1] role recipient
  Notification[0..*] role notifications
end

association Reaction_post between
  Reaction[0..*] role reactions
  Post[1] role post_
end

association Reaction_user between
  Reaction[0..*] role reaction_user_src
  User[1] role user
end

association Media_post between
  Media[0..*] role media
  Post[1] role post_
end

association Tag_posts between
  Tag[0..*] role tag_posts_src
  Post[0..*] role posts
end

association FriendRequest_fromUser between
  FriendRequest[0..*] role friendRequest_fromUser_src
  User[1] role fromUser
end

association FriendRequest_toUser between
  FriendRequest[0..*] role friendRequest_toUser_src
  User[1] role toUser
end

association Comment_post between
  Comment[0..*] role comments
  Post[1] role post_
end

association Comment_author between
  Comment[0..*] role comment_author_src
  User[1] role author
end

constraints
context User inv c000: (self.createdAt <> '') and (self.posts->forAll(v | v.isPublic = true))
context Post inv c001: (self.isPublic = true) and (self.media->forAll(v | v.mediaType <> ''))
context User inv c002: (self.username <> '') and (self.posts->forAll(v | v.isPublic <> false))
context Post inv c003: (self.isPublic = true) and (self.reactions->forAll(v | v.createdAt <> ''))
context Group inv c004: (self.memberships->size() <= 3)
context Tag inv c005: self.posts->size() >= 3 and self.posts->size() <= 3
context Conversation inv c006: self.participants->size() >= 1 and self.participants->size() <= 3
context Post inv c007: (self.comments->size() <= 3)
context User inv c008: (self.notifications->size() <= 2)
context Post inv c009: self.reactions->size() >= 1 and self.reactions->size() <= 1
context Conversation inv c010: self.messages->size() >= 3 and self.messages->size() <= 3
context Group inv c011: self.memberships->size() >= 2 and self.memberships->size() <= 3
context Group inv c012: self.memberships->size() >= 1 and self.memberships->size() <= 2
context Conversation inv c013: (self.participants->size() <= 3)
context Post inv c014: (self.reactions->size() <= 3)
context User inv c015: (self.posts->size() <= 1)
context Post inv c016: (self.media->size() <= 2)
context Post inv c017: self.comments->size() >= 1 and self.comments->size() <= 3
context Reaction inv c018: self.post_.author = self.user
context Media inv c019: self.post_.isPublic
context Group inv c020: self.memberships->forAll(x | x.role_ <> '')
context Post inv c021: self.media->exists(x | x.mediaType <> '')
context Conversation inv c023: (self.participants->collect(x | x.createdAt)->notEmpty()) and (self.messages->size() <= 3)
context Conversation inv c025: (self.participants->one(x | x.createdAt <> '')) and (self.createdAt <> null)
context Reaction inv c034: ((self.post_.author = self.user) and (self.post_.oclIsTypeOf(Post))) and (self.user.oclIsTypeOf(User))
context Group inv c036: self.memberships->exists(x | x.role_ <> '')
context Post inv c037: self.comments->size() > 0
context User inv c038: self.posts->size() >= 1
context Post inv c039: self.reactions->size() <= 1
context Post inv c040: self.media->size() <> 1
context User inv c041: self.notifications->size() > 0
context Conversation inv c042: self.messages->notEmpty()
context Group inv c043: self.memberships->notEmpty()
context User inv c046: self.notifications->size() >= 2 and self.notifications->size() <= 3
context User inv c047: self.posts->size() >= 1 and self.posts->size() <= 1
context User inv c048: self.profile <> null
context Conversation inv c049: self.messages->forAll(x | x.isRead <> false)
context Post inv c051: self.comments->exists(x | x.text <> '')
context User inv c052: (self.email <> '') and (self.posts->forAll(v | v.isPublic = true))
context User inv c053: (self.username <> '') and (self.notifications->forAll(v | v.isSeen <> true))
context Post inv c054: (self.isPublic = true) and (self.comments->forAll(v | v.createdAt <> ''))
context Post inv c055: (self.isPublic <> false) and (self.reactions->forAll(v | v.createdAt <> ''))
context Group inv c056: self.memberships->size() > 0
