model UniversitySystem

enum ProgramLevel {Undergraduate, Postgraduate, PhD}
enum EnrollmentStatus {Enrolled, Dropped, Completed}

class Course
attributes
  code : String
  title : String
  credits : Integer
end

class CourseOffering
attributes
  section : String
  capacity : Integer
end

class Building
attributes
  name : String
  code : String
end

class Exam
attributes
  examDate : String
  type : String
  maxMarks : Integer
end

class ExamAttempt
attributes
  marks : Integer
  attemptDate : String
end

class LibraryAccount
attributes
  accountId : String
  isBlocked : Boolean
end

class Department
attributes
  name : String
  code : String
end

class Semester
attributes
  name : String
  year : Integer
  startDate : String
  endDate : String
end

class GradeRecord
attributes
  letterGrade : String
  points : Integer
end

class Program
attributes
  name : String
  level : ProgramLevel
  durationYears : Integer
end

class Room
attributes
  roomNumber : String
  capacity : Integer
end

class Faculty
attributes
  name : String
end

class University
attributes
  name : String
  code : String
end

class Student
attributes
  studentId : String
  name : String
  email : String
  yearOfStudy : Integer
end

class Instructor
attributes
  staffId : String
  name : String
  email : String
end

class Scholarship
attributes
  name : String
  amount : Integer
  startYear : Integer
  endYear : Integer
end

class Enrollment
attributes
  enrolledAt : String
  status : EnrollmentStatus
end

class Staff
attributes
  staffId : String
  name : String
  role_ : String
end

association Course_department between
  Course[0..*] role courses
  Department[1] role department
end

association Course_offerings between
  Course[1] role course
  CourseOffering[0..*] role offerings
end

association CourseOffering_semester between
  CourseOffering[0..*] role offerings
  Semester[1] role semester
end

association CourseOffering_instructor between
  CourseOffering[0..*] role offerings
  Instructor[1] role instructor
end

association CourseOffering_room between
  CourseOffering[0..*] role offerings
  Room[0..1] role room
end

association CourseOffering_enrollments between
  CourseOffering[1] role offering
  Enrollment[0..*] role enrollments
end

association CourseOffering_exams between
  CourseOffering[1] role offering
  Exam[0..*] role exams
end

association Building_university between
  Building[0..*] role buildings
  University[1] role university
end

association Building_rooms between
  Building[1] role building
  Room[0..*] role rooms
end

association Exam_attempts between
  Exam[1] role exam
  ExamAttempt[0..*] role attempts
end

association ExamAttempt_student between
  ExamAttempt[0..*] role examAttempts
  Student[1] role student
end

association LibraryAccount_student between
  LibraryAccount[0..1] role libraryAccount
  Student[1] role student
end

association Department_faculty between
  Department[0..*] role departments
  Faculty[1] role faculty
end

association Department_programs between
  Department[1] role department
  Program[0..*] role programs
end

association Department_instructors between
  Department[1] role department
  Instructor[0..*] role instructors
end

association Department_staff between
  Department[1] role department
  Staff[0..*] role staff
end

association GradeRecord_enrollment between
  GradeRecord[0..1] role grade
  Enrollment[1] role enrollment
end

association Program_students between
  Program[1] role program
  Student[0..*] role students
end

association Faculty_university between
  Faculty[0..*] role faculties
  University[1] role university
end

association Student_enrollments between
  Student[1] role student
  Enrollment[0..*] role enrollments
end

association Student_scholarships between
  Student[1] role student
  Scholarship[0..*] role scholarships
end

constraints
context Faculty inv c000: self.university.code <> ''
context Enrollment inv c001: self.grade <> null
context Student inv c002: self.libraryAccount.isBlocked
context CourseOffering inv c003: self.room <> null
context Building inv c004: self.university.name <> ''
context GradeRecord inv c006: (self.enrollment.student.yearOfStudy >= 2) and (self.letterGrade <> null)
context ExamAttempt inv c008: (self.student.program.durationYears > 1) and (self.marks.mod(2) = 1)
context Scholarship inv c010: (self.student.program.durationYears < 100) and (self.endYear + self.startYear > 42)
context Enrollment inv c012: (self.grade <> null) and (self.student.program.durationYears < 1000)
context Program inv c013: self.students->exists(x | x.yearOfStudy >= 2)
context University inv c014: self.buildings->forAll(x | x.code <> '')
context Building inv c015: self.rooms->forAll(x | x.capacity > 5)
context Building inv c016: self.rooms->select(x | x.capacity > 10)->size() >= 1
context Building inv c017: (self.rooms->collect(x | x.capacity)->notEmpty()) and (self.rooms->size() >= 2)
context CourseOffering inv c018: self.exams->select(x | x.maxMarks <= 10)->size() >= 1
context Building inv c019: (self.name <> '') and (self.rooms->forAll(v | v.capacity >= 1))
context Room inv c020: (self.capacity >= 10) and (self.offerings->forAll(v | v.capacity <= 100))
context Exam inv c021: (self.maxMarks < 1000) and (self.attempts->forAll(v | v.marks < 10))
context Course inv c022: (self.credits >= 5) and (self.offerings->forAll(v | v.capacity < 50))
context CourseOffering inv c023: (self.capacity >= 5) and (self.enrollments->forAll(v | v.enrolledAt <> ''))
context Program inv c024: (self.durationYears <= 1000) and (self.students->forAll(v | v.yearOfStudy > 1))
context Course inv c025: (self.credits >= 2) and (self.offerings->forAll(v | v.capacity > 0))
context Exam inv c026: self.attempts->forAll(x | x.marks >= 1)
context Building inv c027: self.rooms->exists(x | x.capacity <= 1000)
context Exam inv c028: ((self.attempts->one(x | x.marks > 2)) and (self.offering.oclIsTypeOf(CourseOffering))) and (self.attempts->size() = 2)
context Scholarship inv c029: self.startYear > self.endYear
context Scholarship inv c030: self.endYear <= self.startYear
context Scholarship inv c031: self.startYear - self.endYear >= 3
context CourseOffering inv c032: self.capacity > 0
context Scholarship inv c033: self.endYear + self.startYear > 75
context CourseOffering inv c034: self.capacity >= 0
context CourseOffering inv c035: self.capacity > 27
context Scholarship inv c036: self.startYear - self.endYear >= 5
context Scholarship inv c037: (if self.startYear > self.endYear then self.startYear else self.endYear endif > 11) and (self.endYear.mod(2) = 1)
context CourseOffering inv c038: self.capacity >= 2 and self.capacity <= 65
context CourseOffering inv c039: self.exams->size() >= 2 and self.exams->size() <= 2
context Course inv c041: self.offerings->size() <= 1
context Department inv c042: self.staff->size() > 0
context Building inv c043: self.rooms->size() >= 3
context CourseOffering inv c044: self.enrollments->size() >= 3
context Course inv c045: self.offerings->size() <= 2
context Building inv c046: self.rooms->notEmpty()
context CourseOffering inv c047: self.enrollments->size() > 1
context Scholarship inv c048: self.endYear <> self.startYear
context Building inv c049: self.rooms->size() > 0
context Semester inv c050: self.endDate <> null and self.startDate <> null
context CourseOffering inv c051: self.exams->collect(x | x.maxMarks)->sum() >= 3
context Scholarship inv c052: self.startYear <> null implies self.endYear <> null
context Department inv c053: self.programs->collect(x | x.students)->size() >= 1
context Scholarship inv c054: self.endYear <> null implies self.startYear <> null
context Semester inv c055: self.startDate <> null and self.endDate <> null
context Scholarship inv c056: self.startYear <> null and self.endYear <> null
context Program inv c057: self.students->collect(x | x.yearOfStudy)->sum() >= 1
context Scholarship inv c058: self.endYear <> null and self.startYear <> null
context Department inv c059: self.instructors->collect(x | x.offerings)->flatten()->notEmpty()
context Course inv c061: (self.credits <= 1000) and (self.offerings->forAll(v | v.capacity < 50))
context Scholarship inv c062: (self.endYear + self.startYear > 73) and (self.endYear + self.startYear > 64)
context CourseOffering inv c063: (self.enrollments->size() >= 1) and (self.capacity > 0)
context CourseOffering inv c065: ((self.exams->size() > 0) and (self.room.oclIsTypeOf(Room))) and (self.capacity.mod(2) = 0)
context Department inv c066: (self.name <> '') and (self.courses->forAll(v | v.credits > 0))
context Building inv c067: (self.code <> '') and (self.rooms->forAll(v | v.capacity < 100))
context CourseOffering inv c068: (self.capacity > 10) and (self.enrollments->forAll(v | v.enrolledAt <> ''))
